-const round4 = value => Number(value.toFixed(4));
+function round4(value) {
+  const decimal = /^(\d+)\.(\d{5,})$/.exec(Math.abs(value).toPrecision(15));
+  if (!decimal) return Number(value.toFixed(4));
+
+  const [, whole, fraction] = decimal;
+  // Round the decimal digits so binary floating-point error cannot move a half below the tie.
+  const units = BigInt(whole + fraction.slice(0, 4)) + (fraction[4] >= '5' ? 1n : 0n);
+  const digits = units.toString().padStart(5, '0');
+  const rounded = Number(`${digits.slice(0, -4)}.${digits.slice(-4)}`);
+  return value < 0 ? -rounded : rounded;
+}
 const format = value => String(round4(value));
