index 0000000..0f1b608
--- /dev/null
+++ b/test/performance.test.js
@@ -0,0 +1,71 @@
+import { test, expect } from 'vitest';
+import { analyse } from '../src/analyse.js';
+import { applyFilters } from '../src/filters.js';
+import { orderGroups } from '../src/orders.js';
+import { tradeSummary } from '../src/summary.js';
+import { buildMessage } from './helpers/fix.js';
+
+function frame(type, seq, sender, target, fields = []) {
+  return buildMessage([[8, 'FIX.4.4'], [35, type], [34, seq], [49, sender], [56, target], ...fields]);
+}
+
+function timed(run) {
+  const start = performance.now();
+  const result = run();
+  return { result, ms: performance.now() - start };
+}
+
+test('test_logProcessing_mixed_ten_thousand_messages_meets_time_budgets', () => {
+  const frames = [];
+  for (let i = 0; i < 2_500; i++) {
+    const seq = 2 * i + 1;
+    const clientId = `C${i}`;
+    const symbol = i % 2 === 0 ? 'ALPHA' : 'BETA';
+    frames.push(
+      frame('D', seq, 'CLIENT', 'VENUE', [[11, clientId], [55, symbol], [54, '1'], [38, 2], [40, '2'], [44, 10]]),
+      frame('8', seq, 'VENUE', 'CLIENT', [[11, clientId], [37, `O${i}`], [17, `E${i}`], [150, 'F'],
+        [39, '2'], [55, symbol], [54, '1'], [32, 2], [31, 10]]),
+      frame('0', seq + 1, 'CLIENT', 'VENUE'),
+      frame('0', seq + 1, 'VENUE', 'CLIENT'),
+    );
+  }
+  const log = frames.join('');
+  const analysis = timed(() => analyse(log));
+  const { ok, decoded, errors } = analysis.result;
+  expect(ok).toBe(true);
+  expect(errors).toEqual([]);
+  expect(decoded).toHaveLength(10_000);
+  expect(analysis.ms).toBeLessThan(5_000);
+
+  const groups = timed(() => orderGroups(decoded));
+  expect(groups.result).toHaveLength(2_500);
+  expect(groups.result.every(group => group.numbers.length === 2)).toBe(true);
+  expect(groups.ms).toBeLessThan(1_000);
+
+  const summary = timed(() => tradeSummary(decoded));
+  expect(summary.result.rows).toMatchObject([
+    { symbol: 'ALPHA', buy: { orders: 1_250, fills: 1_250 } },
+    { symbol: 'BETA', buy: { orders: 1_250, fills: 1_250 } },
+  ]);
+  expect(summary.ms).toBeLessThan(1_000);
+
+  const filtered = timed(() => applyFilters(decoded, { senderCompId: 'CLIENT' }));
+  expect(filtered.result).toHaveLength(5_000);
+  expect(filtered.ms).toBeLessThan(1_000);
+}, 15_000);
+
+test('test_analyse_padded_ten_thousand_messages_decodes_under_five_seconds', () => {
+  // Fixed-width sequences keep each frame's encoded size constant.
+  const padding = 'x'.repeat(981);
+  const log = Array.from({ length: 10_000 }, (_, i) =>
+    frame('0', String(i + 1).padStart(5, '0'), 'CLIENT', 'VENUE', [[58, padding]]),
+  ).join('');
+  const bytes = Buffer.byteLength(log);
+  expect(bytes).toBeGreaterThanOrEqual(10_400_000);
+  expect(bytes).toBeLessThanOrEqual(10_485_760);
+  const analysis = timed(() => analyse(log));
+  expect(analysis.result.ok).toBe(true);
+  expect(analysis.result.decoded).toHaveLength(10_000);
+  expect(analysis.result.errors).toEqual([]);
+  expect(analysis.ms).toBeLessThan(5_000);
+}, 10_000);
