+function heartbeat(seq) {
+  return buildMessage([[8, 'FIX.4.4'], [35, '0'], [34, seq], [49, 'A'], [56, 'B']]);
+}
+
+function heartbeatLog(count) {
+  return Array.from({ length: count }, (_, index) => heartbeat(index + 1)).join('');
+}
+
+test('test_analyse_exact_candidate_limit_decodes_all_messages', () => {
+  const result = analyse(heartbeatLog(10_000));
+  expect(result.ok).toBe(true);
+  expect(result.decoded).toHaveLength(10_000);
+  expect(result.errors).toEqual([]);
+});
+
+test('test_analyse_over_candidate_limit_returns_empty_results', () => {
+  const atLimit = heartbeatLog(10_000);
+  const text = atLimit + heartbeat(10_001);
+  expect(Buffer.byteLength(text)).toBeLessThan(1_048_576);
+  expect(analyse(text)).toEqual({
+    ok: false, limit: checkLimits(text), messages: [], errors: [], decoded: [], timeline: [],
+  });
+  expect(checkLimits(atLimit).ok).toBe(true);
+});
