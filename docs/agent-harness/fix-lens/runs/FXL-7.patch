--- /dev/null
+++ b/src/analyse.js
@@ -0,0 +1,17 @@
+import { checkLimits } from './limits.js';
+import { splitMessages, checkMessage } from './framing.js';
+import { decode } from './decode.js';
+import { timeline } from './timeline.js';
+
+export function analyse(text) {
+  const limit = checkLimits(text);
+  if (!limit.ok) return { ok: false, limit, messages: [], errors: [], decoded: [], timeline: [] };
+  const messages = [];
+  const errors = [];
+  for (const candidate of splitMessages(text)) {
+    const error = checkMessage(candidate, text);
+    if (error) errors.push(error);
+    else messages.push(candidate);
+  }
+  return { ok: true, limit, messages, errors, decoded: messages.map(message => decode(message, text)), timeline: timeline(messages) };
+}
