@@ -0,0 +1,53 @@
+import { test, expect } from 'vitest';
+import { readFileSync, readdirSync } from 'node:fs';
+import { JSDOM } from 'jsdom';
+
+const forbidden = [
+  /\bfetch\b/, /\bXMLHttpRequest\b/, /\bWebSocket\b/, /\bsendBeacon\b/, /\bEventSource\b/,
+  /\bwindow\s*\.\s*open\b/, /(?:\blocation\b|\.\s*href)\s*=(?!=)/, /\bsetAttribute\s*\(/,
+  /\blocalStorage\b/, /\bsessionStorage\b/, /\bindexedDB\b/, /\bdocument\s*\.\s*cookie\b/,
+  /\bcookieStore\b/, /\bcaches\b/, /\bopenDatabase\b/, /\bnavigator\s*\.\s*storage\b/,
+  /\bserviceWorker\b/, /\bWorker\s*\(/, /\bSharedWorker\b/,
+  /\bconsole\b/, /\binnerHTML\b/, /\bouterHTML\b/, /\binsertAdjacentHTML\b/,
+  /\bdocument\s*\.\s*write\b/, /\bDOMParser\b/, /\bcreateContextualFragment\b/,
+  /\bsetHTMLUnsafe\b/, /\bsrcdoc\b/, /\beval\b/, /\bnew\s+Function\b/,
+];
+const cspValue = "default-src 'self'; connect-src 'none'; form-action 'none'";
+function stripComments(source) { return source.replace(/<!--[^]*?-->|\/\*[^]*?\*\/|(^|[^:])\/\/[^\r\n]*/gm, (match, prefix) => prefix || ''); }
+function auditSource(source) { return forbidden.filter(pattern => pattern.test(stripComments(source))).map(String); }
+function auditPage(source) {
+  const doc = new JSDOM(source).window.document;
+  const tags = [...doc.querySelectorAll('meta[http-equiv]')].filter(tag => tag.getAttribute('http-equiv').toLowerCase() === 'content-security-policy');
+  return tags.length === 1 && doc.head.firstElementChild === tags[0] && tags[0].getAttribute('content') === cspValue &&
+    doc.querySelectorAll('script:not([src]), style, [style]').length === 0;
+}
+function sources(dir) {
+  return readdirSync(dir, { withFileTypes: true }).flatMap(entry => entry.isDirectory() ? sources(`${dir}/${entry.name}`) : entry.name.endsWith('.js') ? [`${dir}/${entry.name}`] : []);
+}
+
+test('test_static_checks_reject_whitespace_separated_forbidden_apis', () => {
+  for (const source of ['window.fetch ("x")', 'console .log("x")', ...[
+    'XMLHttpRequest', 'WebSocket', 'sendBeacon', 'EventSource', 'window.open', 'location = x', 'node.href = x', 'setAttribute(',
+    'localStorage', 'sessionStorage', 'indexedDB', 'document.cookie', 'cookieStore', 'caches', 'openDatabase', 'navigator.storage', 'serviceWorker', 'Worker(', 'SharedWorker',
+    'innerHTML', 'outerHTML', 'insertAdjacentHTML', 'document.write', 'DOMParser', 'createContextualFragment', 'setHTMLUnsafe', 'srcdoc', 'eval', 'new Function',
+  ]]) expect(auditSource(source), source).not.toHaveLength(0);
+  expect(auditSource('prefetch and myconsole and worker and location == x')).toHaveLength(0);
+});
+
+test('test_static_checks_reject_duplicate_or_invalid_csp', () => {
+  const good = `<html><head><meta http-equiv="Content-Security-Policy" content="${cspValue}"><title>x</title></head><body></body></html>`;
+  expect(auditPage(good)).toBe(true);
+  expect(auditPage(good.replace('<title>', '<meta http-equiv="Content-Security-Policy" content="x"><title>'))).toBe(false);
+  expect(auditPage(good.replace(cspValue, 'default-src *'))).toBe(false);
+  expect(auditPage(good.replace('<head>', '<head><title>before</title>'))).toBe(false);
+});
+
+test('test_static_checks_ignore_comments_and_pass_delivered_sources', () => {
+  expect(auditSource('// fetch console\n/* localStorage */\nconst safe = 1')).toHaveLength(0);
+  expect(auditSource('<!-- console -->')).toHaveLength(0);
+  expect(auditPage(readFileSync('index.html', 'utf8'))).toBe(true);
+  expect(auditSource(readFileSync('index.html', 'utf8'))).toHaveLength(0);
+  const files = sources('src');
+  expect(files.length).toBeGreaterThan(0);
+  for (const file of files) expect(auditSource(readFileSync(file, 'utf8')), file).toHaveLength(0);
+});
