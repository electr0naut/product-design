+// @vitest-environment jsdom
+import { test, expect } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { JSDOM } from 'jsdom';
+import { buildMessage } from './helpers/fix.js';
+
+const html = readFileSync('index.html', 'utf8');
+test('test_page_markup_has_csp_input_sections_and_external_assets', () => {
+  const doc = new JSDOM(html).window.document;
+  const head = doc.head;
+  expect(head.firstElementChild.outerHTML).toContain('Content-Security-Policy');
+  const csp = head.querySelectorAll('meta[http-equiv="Content-Security-Policy"]');
+  expect(csp).toHaveLength(1);
+  expect(csp[0].getAttribute('content')).toBe("default-src 'self'; connect-src 'none'; form-action 'none'");
+  const input = doc.querySelector('textarea');
+  for (const [key, value] of Object.entries({ autocomplete: 'off', spellcheck: 'false', autocapitalize: 'off', autocorrect: 'off', translate: 'no' })) expect(input.getAttribute(key)).toBe(value);
+  expect(doc.querySelector('button').textContent).toMatch(/Decode/);
+  expect([...doc.querySelectorAll('section > h2')].map(h => h.textContent)).toEqual(['Decode', 'Timeline']);
+  expect(head.querySelector('link[rel="stylesheet"]').getAttribute('href')).toBe('styles.css');
+  expect(doc.querySelector('script[type="module"]').getAttribute('src')).toBe('src/main.js');
+  expect(doc.querySelectorAll('script:not([src]), style, [style]')).toHaveLength(0);
+});
+
+test('test_page_second_decode_replaces_output_without_retaining_paste', async () => {
+  document.documentElement.innerHTML = new JSDOM(html).window.document.documentElement.innerHTML;
+  await import('../src/main.js');
+  const input = document.querySelector('textarea');
+  const button = document.querySelector('button');
+  const first = buildMessage([[8, 'FIX.4.4'], [35, 'A'], [34, '1'], [58, 'FIRSTSECRET']]);
+  const second = buildMessage([[8, 'FIX.4.4'], [35, '0'], [34, '2'], [58, 'SECONDSECRET']]);
+  input.value = first; button.click();
+  expect(document.querySelector('#decode').textContent).toContain('FIRSTSECRET');
+  input.value = second; button.click();
+  expect(document.querySelector('#decode').textContent).toContain('SECONDSECRET');
+  expect(document.querySelector('#decode').textContent).not.toContain('FIRSTSECRET');
+  expect(document.querySelector('#timeline').textContent).not.toContain('FIRSTSECRET');
+  expect(document.body.textContent).not.toContain('FIRSTSECRET');
+  expect(document.body.textContent).not.toContain(second);
+  expect(localStorage.length).toBe(0);
+  expect(sessionStorage.length).toBe(0);
+});
