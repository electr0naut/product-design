+import { test, expect } from 'vitest';
+import { analyse } from '../src/analyse.js';
+import { checkLimits } from '../src/limits.js';
+import { buildMessage } from './helpers/fix.js';
+
+const valid = seq => buildMessage([[8, 'FIX.4.4'], [35, 'A'], [34, seq], [49, 'A'], [56, 'B']]);
+
+test('test_analyse_result_has_exact_public_keys', () => {
+  expect(Object.keys(analyse(valid(1))).sort()).toEqual(['decoded', 'errors', 'limit', 'messages', 'ok', 'timeline']);
+});
+
+test('test_analyse_over_limit_returns_warning_without_decoding', () => {
+  const text = valid(1) + 'x'.repeat(1048577);
+  expect(analyse(text)).toEqual({ ok: false, limit: checkLimits(text), messages: [], errors: [], decoded: [], timeline: [] });
+});
+
+test('test_analyse_malformed_between_valid_messages_skips_decode_and_event', () => {
+  const malformed = valid(2).replace('35=A', '35=Z');
+  const result = analyse(valid(1) + malformed + valid(3));
+  expect(result.ok).toBe(true);
+  expect(result.messages.map(m => m.number)).toEqual([1, 3]);
+  expect(result.errors).toMatchObject([{ number: 2, rule: 'checksum' }]);
+  expect(result.decoded.map(m => m.number)).toEqual([1, 3]);
+  expect(result.timeline.filter(e => e.name === 'Logon').map(e => e.number)).toEqual([1, 3]);
+  expect(result.timeline.some(e => e.number === 2)).toBe(false);
+});
