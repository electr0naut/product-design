+/** Render local analysis into the only two output sections. */
+export function render(result) {
+  const decodeSection = document.querySelector('#decode');
+  const timelineSection = document.querySelector('#timeline');
+  for (const section of [decodeSection, timelineSection]) {
+    section.replaceChildren(section.querySelector('h2'));
+  }
+  const add = (parent, tag, text, className) => {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    node.textContent = text;
+    parent.append(node);
+    return node;
+  };
+  if (!result.ok) {
+    add(decodeSection, 'p', result.limit.warning);
+    return;
+  }
+  for (const message of result.decoded) {
+    const card = add(decodeSection, 'article', '');
+    add(card, 'h3', message.label);
+    for (const field of message.fields) {
+      add(card, 'div', `${field.tag} ${field.name}: ${field.value}${field.enumName === null ? '' : ` (${field.enumName})`}`, 'field');
+    }
+  }
+  for (const error of result.errors) add(decodeSection, 'p', error.text);
+  for (const event of result.timeline) {
+    add(timelineSection, 'p', `Message ${event.number}: ${event.name}${event.detail ? ` — ${event.detail}` : ''}`);
+  }
+}
