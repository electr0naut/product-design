+
+function setup() { document.body.innerHTML = '<section id="decode"><h2>Decode</h2></section><section id="timeline"><h2>Timeline</h2></section>'; }
+const result = { ok: true, limit: { ok: true }, decoded: [{ number: 1, label: 'Message 1: Logon', fields: [{ tag: 35, name: 'MsgType', value: 'A', enumName: 'Logon', known: true }] }], errors: [{ number: 2, text: 'Message 2: bad checksum' }], timeline: [{ number: 1, name: 'Logon', kind: 'session', detail: null }] };
+
+test('test_render_valid_result_shows_cards_fields_errors_and_timeline', () => {
+  setup(); render(result);
+  expect(document.querySelectorAll('#decode article')).toHaveLength(1);
