+// Offline policy checks. Kept separate from both Vitest and the browser bundle.
+import { JSDOM } from 'jsdom';
+
+const forbidden = [
+  /\bfetch\b/, /\bXMLHttpRequest\b/, /\bWebSocket\b/, /\bsendBeacon\b/, /\bEventSource\b/,
+  /\bwindow\s*\.\s*open\b/, /(?:\blocation\b|\.\s*href)\s*=(?!=)/, /\bsetAttribute\s*\(/,
+  /\blocalStorage\b/, /\bsessionStorage\b/, /\bindexedDB\b/, /\bdocument\s*\.\s*cookie\b/,
+  /\bcookieStore\b/, /\bcaches\b/, /\bopenDatabase\b/, /\bnavigator\s*\.\s*storage\b/,
+  /\bserviceWorker\b/, /\bWorker\s*\(/, /\bSharedWorker\b/,
+  /\bconsole\b/, /\binnerHTML\b/, /\bouterHTML\b/, /\binsertAdjacentHTML\b/,
+  /\bdocument\s*\.\s*write\b/, /\bDOMParser\b/, /\bcreateContextualFragment\b/,
+  /\bsetHTMLUnsafe\b/, /\bsrcdoc\b/, /\beval\b/, /\bnew\s+Function\b/,
+];
+export const cspValue = "default-src 'self'; connect-src 'none'; form-action 'none'";
+function stripComments(source) {
+  return source.replace(/<!--[^]*?-->|\/\*[^]*?\*\/|(^|[^:])\/\/[^\r\n]*/gm, (_match, prefix = '') => prefix + ' ');
+}
+const sourcePatterns = [
+  ...forbidden,
+  /\bimport\s*\(/,
+  /\b(?:from\s*|import\s*)['"][^'"\r\n]+\.json['"]/,
+  /\.\s*(?:id|name|title|src|value|style|cssText)\s*(?:=(?![=>])|(?:\*\*|>>>|>>|<<|&&|\|\||\?\?|[+\-*/%&^|])=)/,
+];
+export function auditSource(source) {
+  const code = stripComments(source);
+  return sourcePatterns.filter(pattern => pattern.test(code)).map(String);
+}
+export function auditPage(source) {
+  const doc = new JSDOM(source).window.document;
+  const tags = [...doc.querySelectorAll('meta[http-equiv]')].filter(tag => tag.getAttribute('http-equiv').toLowerCase() === 'content-security-policy');
+  if (tags.length !== 1 || doc.head.firstElementChild !== tags[0] || tags[0].getAttribute('content') !== cspValue) return false;
+  return auditElements(doc);
+}
+function auditElements(root) {
+  if (root.querySelector('script:not([src]), style, [style]')) return false;
+  for (const element of root.querySelectorAll('*')) {
+    if (element.getAttributeNames().some(name => /^on./i.test(name))) return false;
+    if (element.localName === 'template' && !auditElements(element.content)) return false;
+  }
+  return true;
+}
+export function auditDataModule(source) {
+  const prefix = 'export default ';
+  const module = source.replace(/\r?\n$/, '');
+  if (!module.startsWith(prefix) || !module.endsWith(';')) return false;
+  try {
+    JSON.parse(module.slice(prefix.length, -1));
+    return true;
+  } catch (error) {
+    if (!(error instanceof SyntaxError)) throw error;
+    return false;
+  }
+}
