@@ -0,0 +1,26 @@
+import { describe, it, expect } from "vitest";
+import { checkMessage, splitMessages } from "../src/framing.js";
+
+const sohReference = "8=FIX.4.4\x019=20\x0135=0\x0134=1\x0149=A\x0156=B\x0110=125\x01";
+const pipeReference = "8=FIX.4.4|9=20|35=0|34=1|49=A|56=B|10=125|";
+const pipeRawChecksum = "8=FIX.4.4|9=20|35=0|34=1|49=A|56=B|10=095|";
+
+describe("FXL-2B: fixed checksum vectors", () => {
+  it("test_checkMessage_soh_reference_returns_null", () => {
+    const candidates = splitMessages(sohReference);
+    expect(candidates).toHaveLength(1);
+    expect(checkMessage(candidates[0], sohReference)).toBeNull();
+  });
+
+  it("test_checkMessage_pipe_reference_returns_null", () => {
+    const candidates = splitMessages(pipeReference);
+    expect(candidates).toHaveLength(1);
+    expect(checkMessage(candidates[0], pipeReference)).toBeNull();
+  });
+
+  it("test_checkMessage_pipe_raw_byte_checksum_returns_checksum", () => {
+    const candidates = splitMessages(pipeRawChecksum);
+    expect(candidates).toHaveLength(1);
+    expect(checkMessage(candidates[0], pipeRawChecksum)).toMatchObject({ rule: "checksum" });
+  });
+});
