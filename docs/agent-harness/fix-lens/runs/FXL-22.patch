+
+function scopedMessage(type, sender, target, ...ids) {
+  return [type, [49, sender], [56, target], ...ids];
+}
+
+const clientLog = [
+  scopedMessage('D', 'ALPHA', 'BRK', [11, '7']),
+  scopedMessage('D', 'BETA', 'BRK', [11, '7']),
+  scopedMessage('8', 'BRK', 'ALPHA', [37, 'X1'], [11, '7']),
+  scopedMessage('8', 'BRK', 'BETA', [37, 'X2'], [11, '7']),
+  scopedMessage('F', 'ALPHA', 'BRK', [11, '8'], [41, '7'], [37, 'X1']),
+  scopedMessage('9', 'BRK', 'ALPHA', [37, 'X1'], [11, '8'], [41, '7']),
+];
+
+test('test_order_groups_shared_clordid_across_clients_keeps_orders_separate', () => {
+  for (const version of ['FIX.4.4', 'FIX.4.2']) {
+    const text = clientLog.map(([type, ...fields]) =>
+      buildMessage([[8, version], [35, type], ...fields]),
+    ).join('\n');
+    const { decoded, errors } = analyse(text);
+    expect(errors).toEqual([]);
+    deepFreeze(decoded);
+    const snapshot = structuredClone(decoded);
+    const groups = orderGroups(decoded);
+    expect(groups).toStrictEqual([
+      { clOrdIds: ['7', '8'], orderIds: ['X1'], numbers: [1, 3, 5, 6] },
+      { clOrdIds: ['7'], orderIds: ['X2'], numbers: [2, 4] },
+    ]);
+    expect(orderGroups(decoded)).toStrictEqual(groups);
+    expect(decoded).toStrictEqual(snapshot);
+  }
+});
+
+const venueLog = [
+  scopedMessage('D', 'FUND', 'NORTH', [11, 'N1']),
+  scopedMessage('D', 'FUND', 'SOUTH', [11, 'S1']),
+  scopedMessage('8', 'NORTH', 'FUND', [37, '5'], [11, 'N1']),
+  scopedMessage('8', 'SOUTH', 'FUND', [37, '5'], [11, 'S1']),
+];
+
+test('test_order_groups_shared_orderid_across_executors_keeps_orders_separate', () => {
+  expect(groupsFor(...venueLog)).toEqual([
+    { clOrdIds: ['N1'], orderIds: ['5'], numbers: [1, 3] },
+    { clOrdIds: ['S1'], orderIds: ['5'], numbers: [2, 4] },
+  ]);
+});
+
+test('test_order_groups_third_party_report_copy_joins_by_orderid', () => {
+  const copy = scopedMessage('8', 'NORTH', 'DESK', [37, '5'], [11, 'N1']);
+  expect(groupsFor(...venueLog, copy).map(group => group.numbers)).toEqual([[1, 3, 5], [2, 4]]);
+});
+
+test('test_order_groups_cancel_without_origclordid_joins_target_executor', () => {
+  const cancel = scopedMessage('F', 'FUND', 'NORTH', [11, 'N2'], [37, '5']);
+  expect(groupsFor(...venueLog, cancel)).toEqual([
+    { clOrdIds: ['N1', 'N2'], orderIds: ['5'], numbers: [1, 3, 5] },
+    { clOrdIds: ['S1'], orderIds: ['5'], numbers: [2, 4] },
+  ]);
+});
+
+test('test_order_groups_missing_and_empty_parties_share_only_empty_scope', () => {
+  const rows = [['D', [11, 'K1']], ['8', [11, 'K1'], [37, 'Z1']], ['D', [49, 'ALPHA'], [11, 'K1']]];
+  expect(groupsFor(...rows).map(group => group.numbers)).toEqual([[1, 2], [3]]);
+  expect(groupsFor(...rows,
+    scopedMessage('D', '', '', [11, 'K1']),
+    scopedMessage('8', '', '', [37, 'Z1']),
+    scopedMessage('8', 'BRK', '', [37, 'Z1']),
+  ).map(group => group.numbers)).toEqual([[1, 2, 4, 5], [3], [6]]);
+});
+
+test('test_order_groups_repeated_party_tags_use_first_values', () => {
+  for (const [client, executor] of [['CLI', 'VENUE'], ['', '']]) {
+    expect(groupsFor(
+      scopedMessage('D', client, executor, [11, 'C'], [49, 'LATER_CLIENT'], [56, 'LATER_EXECUTOR']),
+      scopedMessage('8', executor, client, [11, 'C'], [49, 'OTHER_EXECUTOR'], [56, 'OTHER_CLIENT']),
+      scopedMessage('F', client, executor, [37, 'O'], [49, 'LATER_CLIENT'], [56, 'LATER_EXECUTOR']),
+      scopedMessage('9', executor, client, [37, 'O'], [49, 'OTHER_EXECUTOR'], [56, 'OTHER_CLIENT']),
+      scopedMessage('D', 'LATER_CLIENT', executor, [11, 'C']),
+      scopedMessage('8', 'OTHER_EXECUTOR', client, [37, 'O']),
+    ).map(group => group.numbers)).toEqual([[1, 2], [3, 4], [5], [6]]);
+  }
+});
+
+test('test_order_groups_delimiter_like_characters_keep_key_parts_distinct', () => {
+  for (const separator of ['/', ':']) {
+    const party = `A${separator}B`;
+    const id = `B${separator}C`;
+    expect(groupsFor(
+      scopedMessage('D', party, 'BRK', [11, 'C']),
+      scopedMessage('D', 'A', 'BRK', [11, id]),
+      scopedMessage('8', party, 'CLI', [37, 'C']),
+      scopedMessage('8', 'A', 'CLI', [37, id]),
+      scopedMessage('D', 'BETA', 'BRK', [11, 'C']),
+      scopedMessage('8', 'SOUTH', 'CLI', [37, 'C']),
+    ).map(group => group.numbers)).toEqual([[1], [2], [3], [4], [5], [6]]);
+  }
+});
+
+test('test_order_groups_party_and_identifier_case_differences_keep_orders_separate', () => {
+  expect(groupsFor(
+    scopedMessage('D', 'CLI', 'BRK', [11, 'ID']),
+    scopedMessage('D', 'cli', 'BRK', [11, 'ID']),
+    scopedMessage('D', 'CLI', 'BRK', [11, 'id']),
+  ).map(group => group.numbers)).toEqual([[1], [2], [3]]);
+});
+
+test('test_order_groups_same_party_and_value_keep_identifier_namespaces_separate', () => {
+  expect(groupsFor(
+    scopedMessage('D', 'SELF', 'SELF', [11, '1']),
+    scopedMessage('8', 'SELF', 'SELF', [37, '1']),
+    scopedMessage('8', 'BRK', 'SELF', [37, '1']),
+  )).toEqual([
+    { clOrdIds: ['1'], orderIds: [], numbers: [1] },
+    { clOrdIds: [], orderIds: ['1'], numbers: [2] },
+    { clOrdIds: [], orderIds: ['1'], numbers: [3] },
+  ]);
+});
+
+const lookupLog = [
+  scopedMessage('D', 'ALPHA', 'BRK', [11, '500']),
+  scopedMessage('D', 'BETA', 'BRK', [11, 'Q9']),
+  scopedMessage('8', 'BRK', 'ALPHA', [37, '12'], [11, '500']),
+  scopedMessage('8', 'BRK', 'BETA', [37, '500'], [11, 'Q9']),
+  ['0'],
+];
+
+test('test_find_order_matching_message_number_takes_precedence_over_identifier', () => {
+  const groups = groupsFor(...lookupLog);
+  expect(groups.map(group => group.numbers)).toEqual([[1, 3], [2, 4]]);
+  expect(findOrder(groups, '500', 4)).toBe(groups[1]);
+  expect(findOrder(groups, 'nope', 4)).toBe(groups[1]);
+  expect(findOrder(groups, '500', 3)).toBe(groups[0]);
+});
+
+test('test_find_order_absent_or_unmatched_message_number_falls_back_to_first_identifier_match', () => {
+  const sameClOrdId = scopedMessage('D', 'BETA', 'BRK', [11, '500']);
+  for (const groups of [groupsFor(...lookupLog), groupsFor(...lookupLog, sameClOrdId)]) {
+    const first = groups[0];
+    expect(first.numbers).toEqual([1, 3]);
+    expect(findOrder(groups, '500')).toBe(first);
+    for (const number of [null, 5, 99]) expect(findOrder(groups, '500', number)).toBe(first);
+    expect(findOrder(groups, 'nope', 99)).toBeNull();
+  }
+});
+
+test('test_order_groups_ten_thousand_messages_from_fifty_clients_finishes_under_one_second', () => {
+  const rows = [];
+  const clients = 50;
+  const ordersPerClient = 100;
+  for (let i = 0; i < clients; i++) {
+    const client = `CLIENT${i}`;
+    for (let j = 0; j < ordersPerClient; j++) {
+      rows.push(scopedMessage('D', client, 'BRK', [11, String(j)]));
+      rows.push(scopedMessage('8', 'BRK', client, [11, String(j)], [37, `O${i}-${j}`]));
+    }
+  }
+  const { decoded, errors } = analyse(log(...rows));
+  expect(errors).toEqual([]);
+  expect(decoded).toHaveLength(10_000);
+
+  const start = performance.now();
+  const groups = orderGroups(decoded);
+  const elapsed = performance.now() - start;
+
+  expect(elapsed).toBeLessThan(1000);
+  expect(groups).toHaveLength(clients * ordersPerClient);
+  expect(groups.every(({ numbers }) => numbers.length === 2)).toBe(true);
+});
