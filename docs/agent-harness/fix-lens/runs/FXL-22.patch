index f34a377..b839d17 100644
--- a/src/orders.js
+++ b/src/orders.js
@@ -12,13 +12,23 @@ function union(left, right) {
   a.size += b.size;
 }
 
-/** Group decoded FIX messages by their connected order identifiers. */
+function firstValue(fields, tag) {
+  return fields.find(field => field.tag === tag)?.value ?? '';
+}
+
+/** Group decoded FIX messages by their connected, party-scoped order identifiers. */
 export function orderGroups(decoded) {
   const clientNodes = new Map();
   const orderNodes = new Map();
   const messages = [];
 
   for (const { number, fields } of decoded) {
+    const type = firstValue(fields, 35);
+    const sender = firstValue(fields, 49);
+    const target = firstValue(fields, 56);
+    const isReply = type === '8' || type === '9';
+    const client = isReply ? target : sender;
+    const executor = isReply ? sender : target;
     const seenTags = new Set();
     const nodes = [];
     for (const { tag, value } of fields) {
@@ -29,10 +39,16 @@ export function orderGroups(decoded) {
       if (value === '' || (isOrderId && value === 'NONE')) continue;
 
       const namespace = isOrderId ? orderNodes : clientNodes;
-      let node = namespace.get(value);
+      const party = isOrderId ? executor : client;
+      let partyNodes = namespace.get(party);
+      if (!partyNodes) {
+        partyNodes = new Map();
+        namespace.set(party, partyNodes);
+      }
+      let node = partyNodes.get(value);
       if (!node) {
         node = { value, isOrderId, parent: null, size: 1 };
-        namespace.set(value, node);
+        partyNodes.set(value, node);
       }
       if (nodes.length > 0) union(nodes[0], node);
       nodes.push(node);
@@ -60,7 +76,11 @@ export function orderGroups(decoded) {
   }));
 }
 
-/** Return the first group containing the exact identifier, or null. */
-export function findOrder(groups, id) {
+/** Prefer the group containing the message number, then the first exact ID match. */
+export function findOrder(groups, id, number) {
+  if (number != null) {
+    const group = groups.find(({ numbers }) => numbers.includes(number));
+    if (group) return group;
+  }
   return groups.find(({ clOrdIds, orderIds }) => clOrdIds.includes(id) || orderIds.includes(id)) ?? null;
 }
