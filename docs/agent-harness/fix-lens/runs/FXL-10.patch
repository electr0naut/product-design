+/** Classify a FIX ExecutionReport using the first raw value of each tag. */
+export function executionKind(message) {
+  const value = tag => message.fields.find(field => field.tag === tag)?.value ?? null;
+  const version = value(8);
+  const execType = value(150);
+
+  if (version === 'FIX.4.2') {
+    const transType = value(20);
+    if (transType === '1') return 'TradeCancel';
+    if (transType === '2') return 'TradeCorrect';
+    if (transType === '3') return 'OrderStatus';
+    if (execType === '1' || execType === '2') return 'Fill';
+  } else if (version === 'FIX.4.4') {
+    if (execType === 'H') return 'TradeCancel';
+    if (execType === 'G') return 'TradeCorrect';
+    if (execType === 'I') return 'OrderStatus';
+    if (execType === 'F') return 'Fill';
+  }
+
+  if (execType === '0') return 'Acknowledgement';
+  if (execType === '4') return 'Cancelled';
+  if (execType === '5') return 'Replaced';
+  if (execType === null) return 'ExecutionReport (no ExecType)';
+  return `ExecutionReport (ExecType ${execType})`;
+}
