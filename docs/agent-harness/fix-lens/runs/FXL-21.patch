+++ b/src/main.js
@@ -21,16 +21,16 @@ themeButton.addEventListener('click', () => {
 themeButton.hidden = false;
 
 const input = document.querySelector('#paste');
-const view = { orderId: null, filters: {} };
+const view = { orderId: null, filters: {}, page: 1 };
 let result;
 const handlers = {
   pick(id) {
     view.orderId = id;
-    renderCurrent();
+    renderFirstPage();
   },
   clear() {
     view.orderId = null;
-    renderCurrent();
+    renderFirstPage();
   },
   setFilter(key, value) {
     if (key == null) {
@@ -40,14 +40,24 @@ const handlers = {
     } else {
       view.filters[key] = value;
     }
+    renderFirstPage();
+  },
+  setPage(page) {
+    view.page = page;
     renderCurrent();
+    const results = document.querySelector('.results');
+    if (typeof results?.scrollIntoView === 'function') results.scrollIntoView();
