 });
diff --git a/src/render.js b/src/render.js
index 784830a..ec155dc 100644
--- a/src/render.js
+++ b/src/render.js
@@ -1,6 +1,7 @@
 import { findOrder, orderGroups } from './orders.js';
 import { tradeSummary } from './summary.js';
 import { FILTERS, filterOptions, applyFilters } from './filters.js';
+import { pageOf, pageLabel } from './paging.js';
 
 // Text and classes travel separately: call sites supply only fixed class names.
 function add(parent, tag, className, text) {
@@ -95,6 +96,23 @@ function renderFilters(section, decoded, view, handlers) {
   }
 }
 
+function renderPager(section, info, narrowed, handlers) {
+  const pager = add(section, 'nav', 'pager');
+  add(pager, 'span', 'page-info', pageLabel(info, narrowed));
+  const { page, pages } = info;
+  const controls = [
+    [add(pager, 'button', 'page-first', 'First'), 1, page === 1],
+    [add(pager, 'button', 'page-prev', 'Previous'), page - 1, page === 1],
+    [add(pager, 'button', 'page-next', 'Next'), page + 1, page === pages],
+    [add(pager, 'button', 'page-last', 'Last'), pages, page === pages],
+  ];
+  for (const [button, destination, disabled] of controls) {
+    button.type = 'button';
+    button.disabled = disabled;
+    button.addEventListener('click', () => handlers?.setPage?.(destination));
+  }
+}
+
 const fieldOf = (message, tag) => message.fields.find(field => field.tag === tag);
 const valueOf = (message, tag) => fieldOf(message, tag)?.value;
 
@@ -207,11 +225,14 @@ function renderCard(section, message, handlers) {
   }
 }
 
-function renderMessages(section, decoded, errors, handlers, narrowed) {
-  const entries = [...decoded.map(message => ({ number: message.number, message })),
-    ...errors.map(error => ({ number: error.number, error }))];
+function messageEntries(decoded, errors) {
+  return [...decoded.map(message => ({ number: message.number, message })),
+    ...errors.map(error => ({ number: error.number, error }))].sort((a, b) => a.number - b.number);
+}
+
+function renderMessages(section, entries, handlers, narrowed) {
   if (!entries.length) add(section, 'p', 'empty', narrowed ? NO_MATCHES : NO_MESSAGES);
-  for (const { message, error, number } of entries.sort((a, b) => a.number - b.number)) {
+  for (const { message, error, number } of entries) {
     if (message) {
       renderCard(section, message, handlers);
     } else {
@@ -225,7 +246,7 @@ function renderMessages(section, decoded, errors, handlers, narrowed) {
 }
 
 /** Replace generated output without replacing the page's headings.
- * Optional view: { orderId, filters }; optional handlers: { pick, clear, setFilter }.
+ * Optional view: { orderId, filters, page }; optional handlers: { pick, clear, setFilter, setPage }.
  */
 export function render(result, view, handlers) {
   const summary = document.querySelector('#summary');
@@ -262,6 +283,13 @@ export function render(result, view, handlers) {
   renderStats(summary, { decoded, errors, events, groups, shown, total, narrowed });
   renderTrades(summary, tradeSummary(result.decoded, narrowed ? shown : undefined));
   renderFilters(summary, result.decoded, view, handlers);
-  renderTimeline(timeline, events, handlers);
-  renderMessages(decode, decoded, errors, handlers, narrowed);
+
+  const info = pageOf(messageEntries(decoded, errors), view?.page);
+  const pageNumbers = new Set(info.items.filter(entry => entry.message).map(entry => entry.number));
+  renderTimeline(timeline, events.filter(event => pageNumbers.has(event.number)), handlers);
+  renderMessages(decode, info.items, handlers, narrowed);
+  if (info.pages > 1) {
+    renderPager(summary, info, narrowed, handlers);
+    renderPager(decode, info, narrowed, handlers);
+  }
 }
