+import { readFileSync, writeFileSync, mkdirSync, copyFileSync } from 'fs';
+import { join, dirname } from 'path';
+import { fileURLToPath } from 'url';
+import { JSDOM } from 'jsdom';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = dirname(__filename);
+const root = join(__dirname, '..');
+
+// Read the commit hash from SOURCE.md
+const sourceMd = readFileSync(join(root, 'vendor/orchestra/SOURCE.md'), 'utf-8');
+const commitMatch = sourceMd.match(/Commit:\s*([a-f0-9]{40})/);
+if (!commitMatch) {
+  throw new Error('Could not find commit hash in vendor/orchestra/SOURCE.md');
+}
+const commit = commitMatch[1];
+
+// Parse XML using jsdom's DOMParser
+const dom = new JSDOM();
+const parser = new dom.window.DOMParser();
+
+function parseOrchestra(xmlPath) {
+  const xml = readFileSync(xmlPath, 'utf-8');
+  const doc = parser.parseFromString(xml, 'text/xml');
+  
+  // Extract code sets
+  const codeSets = {};
+  const codeSetElements = doc.querySelectorAll('codeSet');
+  for (const cs of codeSetElements) {
+    const name = cs.getAttribute('name');
+    const codes = {};
+    const codeElements = cs.querySelectorAll('code');
+    for (const code of codeElements) {
+      const value = code.getAttribute('value');
+      const codeName = code.getAttribute('name');
+      if (value && codeName) {
+        codes[value] = codeName;
+      }
+    }
+    codeSets[name] = codes;
+  }
+  
+  // Extract fields
+  const fields = {};
+  const fieldElements = doc.querySelectorAll('field');
+  for (const field of fieldElements) {
+    const id = field.getAttribute('id');
+    const name = field.getAttribute('name');
+    const type = field.getAttribute('type');
+    
+    if (id && name && type) {
+      const fieldObj = { name, type };
+      
+      // Add enum values if the type ends with 'CodeSet'
+      if (type.endsWith('CodeSet') && codeSets[type]) {
+        fieldObj.enumValues = codeSets[type];
+      }
+      
+      fields[id] = fieldObj;
+    }
+  }
+  
+  return { fields, commit };
+}
+
+// Build dictionaries
+const fix42 = parseOrchestra(join(root, 'vendor/orchestra/OrchestraFIX42.xml'));
+const fix44 = parseOrchestra(join(root, 'vendor/orchestra/OrchestraFIX44.xml'));
+
+// Sort fields by tag number (numeric sort)
+function sortFields(fields) {
+  const sorted = {};
+  const keys = Object.keys(fields).sort((a, b) => parseInt(a) - parseInt(b));
+  for (const key of keys) {
+    const field = fields[key];
+    const sortedField = { name: field.name, type: field.type };
+    if (field.enumValues) {
+      // Sort enum values by value
+      const sortedEnums = {};
+      const enumKeys = Object.keys(field.enumValues).sort();
+      for (const enumKey of enumKeys) {
+        sortedEnums[enumKey] = field.enumValues[enumKey];
+      }
+      sortedField.enumValues = sortedEnums;
+    }
+    sorted[key] = sortedField;
+  }
+  return sorted;
+}
+
+const output42 = { fields: sortFields(fix42.fields), commit: fix42.commit };
+const output44 = { fields: sortFields(fix44.fields), commit: fix44.commit };
+
+// Create output directory
+const dictDir = join(root, 'src/dictionary');
+mkdirSync(dictDir, { recursive: true });
+
+// Write JSON files with deterministic formatting
+writeFileSync(join(dictDir, 'FIX42.json'), JSON.stringify(output42, null, 2) + '\n');
+writeFileSync(join(dictDir, 'FIX44.json'), JSON.stringify(output44, null, 2) + '\n');
+
+// Copy LICENSE
+copyFileSync(join(root, 'vendor/orchestra/LICENSE'), join(dictDir, 'LICENSE'));
+
+// Create SOURCE.md
+const sourceContent = `# Dictionary Source
+
+Generated from FIX Orchestra files.
+
+- Commit: ${commit}
+- Source: vendor/orchestra/SOURCE.md
+`;
+writeFileSync(join(dictDir, 'SOURCE.md'), sourceContent);
+
+console.log('Dictionary build complete');
