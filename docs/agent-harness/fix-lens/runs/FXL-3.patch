diff --git a/src/dictionary.js b/src/dictionary.js
new file mode 100644
index 0000000..fbbde23
--- /dev/null
+++ b/src/dictionary.js
@@ -0,0 +1,34 @@
+import fix42Data from './dictionary/FIX42.json' with { type: 'json' };
+import fix44Data from './dictionary/FIX44.json' with { type: 'json' };
+
+const dictionaries = {
+  'FIX.4.2': fix42Data,
+  'FIX.4.4': fix44Data
+};
+
+export function lookup(tag, beginString) {
+  const dict = dictionaries[beginString];
+  if (!dict) {
+    return null;
+  }
+  
+  const field = dict.fields[String(tag)];
+  if (!field) {
+    return null;
+  }
+  
+  return {
+    name: field.name,
+    type: field.type,
+    ...(field.enumValues && { enumValues: field.enumValues })
+  };
+}
+
+export function enumName(tag, value, beginString) {
+  const field = lookup(tag, beginString);
+  if (!field || !field.enumValues) {
+    return null;
+  }
+  
+  return field.enumValues[String(value)] || null;
+}
