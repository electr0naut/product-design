+    const parts = [`Message ${event.number}: ${event.name}`];
+    if (event.sendingTime != null) parts.push(event.sendingTime);
+    if (event.sender != null || event.target != null) parts.push(`${event.sender ?? ''} → ${event.target ?? ''}`);
+    if (event.seqNum != null) parts.push(`seq ${event.seqNum}`);
+    if (event.kind === 'order') {
+      if (event.clOrdId != null) parts.push(`ClOrdID ${event.clOrdId}`);
+      if (event.orderId != null) parts.push(`OrderID ${event.orderId}`);
+    }
+    if (event.detail) parts.push(event.detail);
+    add(timelineSection, 'p', parts.join(' — '));
   }
 }
