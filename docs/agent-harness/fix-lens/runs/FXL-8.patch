+test('test_dictionary_generated_js_is_reproducible_without_mutating_src', () => {
+  const before = snapshot();
+  const folder = mkdtempSync(join(tmpdir(), 'fix-js-repro-'));
+  try {
+    build(folder);
+    for (const version of ['42', '44']) {
+      const generated = readFileSync(join(folder, `fix${version}.js`));
+      expect(generated.equals(committed(version))).toBe(true);
+    }
+    expect(readdirSync(dictDir)).toEqual(Object.keys(before));
+    for (const [name, bytes] of Object.entries(before)) {
+      expect(readFileSync(join(dictDir, name)).equals(bytes)).toBe(true);
+    }
+  } finally {
+    rmSync(folder, { recursive: true, force: true });
+  }
+});
