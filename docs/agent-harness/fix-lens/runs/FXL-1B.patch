--- /dev/null
+++ b/test/framing-f1b.test.js
@@ -0,0 +1,45 @@
+import { describe, it, expect } from "vitest";
+import { splitMessages, checkMessage } from "../src/framing.js";
+
+describe("FXL-1b: splitMessages interface and boundary rules", () => {
+  it("test_splitMessages_candidate_and_field_shapes_match_interface", () => {
+    const text = "prefix 8=FIX.4.4|9=5|35=0|10=123|";
+    const [candidate] = splitMessages(text);
+    expect(Object.keys(candidate).sort()).toEqual(["end", "fields", "number", "start"]);
+    expect(candidate.end).toBe(text.length);
+    expect(candidate.start).toBe(text.indexOf("8=FIX"));
+    for (const field of candidate.fields) {
+      expect(Object.keys(field).sort()).toEqual(["position", "tag", "value"]);
+      expect(text.slice(field.position)).toMatch(new RegExp(`^${field.tag}=`));
+    }
+  });
+
+  it("test_splitMessages_equals_prefix_without_delimiter_starts_candidate", () => {
+    const text = "session=ABC 8=FIX.4.4|9=5|35=0|10=123|";
+    expect(splitMessages(text)[0].start).toBe(text.indexOf("8=FIX"));
+    const delimited = "8=FIX.4.4|9=5|35=0|58=resend 8=FIX.4.2|10=123|";
+    const candidates = splitMessages(delimited);
+    expect(candidates).toHaveLength(1);
+    expect(candidates[0].fields.find(f => f.tag === 58).value).toBe("resend 8=FIX.4.2");
+  });
+
+  it("test_splitMessages_missing_checksum_at_line_end_returns_candidate", () => {
+    const text = "8=FIX.4.4|9=5|35=0|\n8=FIX.4.4|9=5|35=0|10=123|";
+    const [candidate] = splitMessages(text);
+    expect(candidate.end).toBe(text.indexOf("\n"));
+    expect(candidate.fields.map(f => f.tag)).toEqual([8, 9, 35]);
+    expect(checkMessage(candidate, text)?.rule).toBe("missing_checksum");
+  });
+
+  it("test_splitMessages_delimiter_adjacent_start_before_checksum_splits_candidates", () => {
+    const text = "8=FIX.4.4|9=5|35=0|8=FIX.4.4|9=5|35=0|10=123|";
+    const candidates = splitMessages(text);
+    expect(candidates).toHaveLength(2);
+    expect(candidates.map(c => c.number)).toEqual([1, 2]);
+    expect(candidates[0].end).toBe(candidates[1].start);
+    expect(candidates[0].fields.map(f => f.tag)).toEqual([8, 9, 35]);
+    expect(candidates[1].fields.map(f => f.tag)).toEqual([8, 9, 35, 10]);
+    const notAStart = "8=FIX.4.4|9=5|35=0|8=FIXCLIENT|10=123|";
+    expect(splitMessages(notAStart)).toHaveLength(1);
+  });
+});
