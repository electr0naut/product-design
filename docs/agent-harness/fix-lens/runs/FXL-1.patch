+// Test helper: build a well-formed FIX message string.
+//
+// buildMessage(fields, opts?)
+//   fields: array of [tag, value] pairs (numbers or strings for tag).
+//   opts.delim: delimiter character (default "|").
+//
+// The helper:
+//   - Always emits tag 8 (BeginString) first. The caller must include it.
+//   - Computes tag 9 (BodyLength) as the byte length of everything between
+//     the end of "9=<len><delim>" and the start of "10=...".
+//   - Computes tag 10 (CheckSum) as the sum of all bytes in the message
+//     up to (not including) "10=", modulo 256, zero-padded to 3 digits.
+//   - Returns the full string including 8=, 9=, and 10= fields, terminated
+//     by the delimiter after the checksum.
+
+export function buildMessage(fields, opts = {}) {
+  const delim = opts.delim ?? "|";
+
+  // Separate the BeginString (tag 8) from the rest.
+  let beginString = null;
+  const bodyFields = [];
+  for (const [tag, value] of fields) {
+    const t = Number(tag);
+    if (t === 8) {
+      beginString = String(value);
+    } else if (t === 9 || t === 10) {
+      // Caller should not supply these; we compute them.
+      continue;
+    } else {
+      bodyFields.push([t, String(value)]);
+    }
+  }
+  if (beginString === null) {
+    throw new Error("buildMessage: fields must include tag 8 (BeginString)");
+  }
+
+  // Build the body (everything between 9=...<delim> and 10=...).
+  let body = "";
+  for (const [t, v] of bodyFields) {
+    body += `${t}=${v}${delim}`;
+  }
+
+  const bodyLength = new TextEncoder().encode(body).length;
+
+  // Build message up to (not including) the checksum field.
+  let msg = `8=${beginString}${delim}9=${bodyLength}${delim}${body}`;
+
+  // Compute checksum: sum of all bytes so far, mod 256, zero-padded to 3 digits.
+  const bytes = new TextEncoder().encode(msg);
+  let sum = 0;
+  for (const b of bytes) sum += b;
+  const checksum = (sum % 256).toString().padStart(3, "0");
+
+  msg += `10=${checksum}${delim}`;
+  return msg;
+}
