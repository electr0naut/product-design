+
+
+// ---- FXL-16: the trading summary and the filters ----
+
+vi.mock('../src/summary.js', async importOriginal => {
+  const actual = await importOriginal();
+  return { ...actual, tradeSummary: vi.fn(actual.tradeSummary) };
+});
+
+const NOTE = 'Bought and sold are filled quantities from execution reports in this log, counted once per ExecID, after trade cancels and corrections.';
+const tradeRows = () => all('#summary div.trades table.trade-table tbody tr').map(cells);
+const filterLabels = () => all('#summary div.filters label.filter');
+const filterSelects = () => all('#summary div.filters label.filter select');
+const tradePanel = () => select('#summary div.trades');
+const filterView = filters => ({ orderId: null, filters });
+const setSelect = (node, index) => {
+  node.selectedIndex = index;
+  node.dispatchEvent(new Event('change'));
+};
+
+const logA = [
+  '35=D 11=C1 1=ACC1 55=VOD.L 54=1 38=1000',
+  '35=8 37=O1 11=C1 17=E1 150=F 55=VOD.L 54=1 32=400 31=71.25',
+  '35=8 37=O1 11=C1 17=E2 150=F 55=VOD.L 54=1 32=600 31=71.5',
+  '35=8 43=Y 37=O1 11=C1 17=E2 150=F 55=VOD.L 54=1 32=600 31=71.5',
+  '35=8 37=O1 11=C1 17=E3 19=E1 150=G 55=VOD.L 54=1 32=300 31=71.2',
+  '35=8 37=O1 11=C1 17=E4 19=E2 150=H 55=VOD.L 54=1 32=0 31=0',
+  '35=D 11=C2 1=ACC2 55=VOD.L 54=2 38=500',
+  '35=8 37=O2 11=C2 17=E5 150=F 55=VOD.L 54=2 32=200 31=72',
+  '35=8 37=O2 11=C2 17=E6 19=E5 150=G 55=VOD.L 54=2 32=250 31=72.1',
+  '35=8 37=O2 11=C2 17=E7 19=E6 150=G 55=VOD.L 54=2 32=260 31=72.2',
+  '35=8 37=O9 11=C9 17=E8 19=ZZ 150=H 55=VOD.L 54=1 32=0',
+  '35=8 37=O8 11=C3 17=E9 19=YY 150=G 55=BARC.L 54=5 32=50 31=2.5',
+  '35=D 11=C3 1=ACC1 55=BARC.L 54=5 38=50',
+  '35=8 37=O3 11=C4 17=E10 150=F 55=AZN.L 54=1 32=10',
+  '35=8 37=O3 11=C4 17=E11 150=F 55=AZN.L 54=8 32=10 31=100',
+  '35=8 37=O3 11=C4 17=E12 150=F 54=1 32=10 31=100',
+  '35=8 37=O3 11=C4 17=E13 150=F 55=AZN.L 54=1 32=0 31=100',
+  '35=8 37=O1 11=C1 17=E14 19=E2 150=G 55=VOD.L 54=1 32=999 31=1',
+  '35=8 37=O3 11=C4 17=E15 150=0 55=AZN.L 54=1 32=5 31=100',
+];
+
+function frame(line, number) {
+  const [type, ...fields] = line.split(' ').map(field => field.split('='));
+  return buildMessage([[8, 'FIX.4.4'], type, [49, 'SENDER'], [56, 'TARGET'], [34, number], ...fields]);
+}
+
+const logAResult = () => analyse(logA.map((line, index) => frame(line, index + 1)).join('\n'));
+const fillMessage = (symbol, side, execId, qty, price) => fix('8', [37, `O-${symbol}`], [11, `C-${symbol}`],
+  [17, execId], [150, 'F'], [55, symbol], [54, side], [32, qty], [31, price]);
+
+test('test_render_summary_section_order_after_stats', () => {
+  show(order('D', 'C1', [55, 'VOD.L'], [54, '1']), fix('0'));
+  const children = [...select('#summary').children];
+  expect(children.map(node => `${node.localName}.${node.className}`))
+    .toEqual(['div.stats', 'div.trades', 'div.filters']);
+  const trades = children[1];
+  const filters = children[2];
+  expect(trades.matches('div.trades')).toBe(true);
+  expect(filters.matches('div.filters')).toBe(true);
+  expect(children.indexOf(trades)).toBeLessThan(children.indexOf(filters));
+
+  render(analyseLog(order('D', 'C1', [55, 'VOD.L'], [54, '1'])), viewOrder('C1'));
+  expect([...select('#summary').children].map(node => node.className))
+    .toEqual(['order-story', 'stats', 'trades', 'filters']);
+});
+
+test('test_render_trades_table_headers_and_rows', () => {
+  const result = analyseLog(
+    order('D', 'C1', [55, 'VOD.L'], [54, '1']),
+    order('8', 'C1', [37, 'O1'], [17, 'E1'], [150, 'F'], [55, 'VOD.L'], [54, '1'], [32, '10'], [31, '2']),
+    order('D', 'C2', [55, 'BARC.L'], [54, '2']),
+  );
+  render(result);
+  const table = select('#summary div.trades table.trade-table');
+  expect(table).not.toBeNull();
+  expect(texts(table.querySelectorAll('thead th')))
+    .toEqual(['Symbol', 'Buy orders', 'Bought', 'Avg buy', 'Sell orders', 'Sold', 'Avg sell', 'Net']);
+  const expected = tradeSummary(result.decoded).rows.map(row => row.symbol);
+  expect(expected).toEqual(['BARC.L', 'VOD.L']);
+  expect(tradeRows().map(row => row[0])).toEqual(expected);
+  expect(tradeRows()).toHaveLength(expected.length);
+});
+
+test('test_render_format_rounds_to_four_decimals_without_trailing_zeros', () => {
+  render(analyseLog(
+    fillMessage('AAA', '1', 'E1', '1500', '1'),
+    fillMessage('BBB', '1', 'E2', '71.25', '1'),
+    fillMessage('CCC', '1', 'E3', '0.1', '1'),
+    fillMessage('CCC', '1', 'E4', '0.2', '1'),
+    fillMessage('DDD', '1', 'E5', '1234.56789', '1'),
+    fillMessage('EEE', '1', 'E6', '2', '1'),
+    fillMessage('EEE', '1', 'E7', '1', '0'),
+  ));
+  const bySymbol = Object.fromEntries(tradeRows().map(row => [row[0], row]));
+  expect(bySymbol.AAA[2]).toBe('1500');
+  expect(bySymbol.AAA[3]).toBe('1');
+  expect(bySymbol.BBB[2]).toBe('71.25');
+  expect(bySymbol.CCC[2]).toBe('0.3');
+  expect(bySymbol.DDD[2]).toBe('1234.5679');
+  expect(bySymbol.EEE[2]).toBe('3');
+  expect(bySymbol.EEE[3]).toBe('0.6667');
+  expect(bySymbol.AAA[1]).toBe('0');
+  expect(bySymbol.AAA[4]).toBe('0');
+});
+
+test('test_render_format_net_leading_plus_and_zero_never_signed', () => {
+  render(analyseLog(
+    fillMessage('AAA', '1', 'E1', '0.1', '1'),
