+function renderTrades(section, summary) {
+  const trades = add(section, 'div', 'trades');
+  if (summary.rows.length === 0) {
+    add(trades, 'p', 'empty', NO_TRADES);
+    return;
+  }
+  const table = add(trades, 'table', 'trade-table');
+  const head = add(table, 'thead');
+  const columns = add(head, 'tr');
+  for (const label of TRADE_COLUMNS) add(columns, 'th', null, label);
+  const body = add(table, 'tbody');
+  for (const { symbol, buy, sell } of summary.rows) {
+    const row = add(body, 'tr');
+    const values = [symbol, buy.orders, format(buy.filledQty), average(buy),
+      sell.orders, format(sell.filledQty), average(sell), netText(buy.filledQty - sell.filledQty)];
+    for (const value of values) add(row, 'td', null, value);
+  }
+  add(trades, 'p', 'note', TRADE_NOTE);
+  if (summary.unmatched > 0) add(trades, 'p', 'note unmatched', unmatchedText(summary.unmatched));
+}
+
+function renderFilters(section, decoded, view, handlers) {
+  const panel = add(section, 'div', 'filters');
+  const options = filterOptions(decoded);
+  const chosen = view?.filters ?? {};
+  for (const { key, label } of FILTERS) {
+    const wrapper = add(panel, 'label', 'filter');
+    add(wrapper, 'span', null, label);
+    const select = add(wrapper, 'select');
+    add(select, 'option', null, 'All');
+    const values = options[key];
+    for (const value of values) add(select, 'option', null, value);
+    if (chosen[key] != null && values.includes(chosen[key])) select.selectedIndex = values.indexOf(chosen[key]) + 1;
+    select.disabled = values.length === 0;
+    select.addEventListener('change', () => handlers?.setFilter?.(key, values[select.selectedIndex - 1] ?? null));
+  }
+  if (FILTERS.some(({ key }) => chosen[key] != null)) {
+    const button = add(panel, 'button', 'clear-filters', 'Clear filters');
+    button.type = 'button';
+    button.addEventListener('click', () => handlers?.setFilter?.(null, null));
+  }
+}
+
 const fieldOf = (message, tag) => message.fields.find(field => field.tag === tag);
 const valueOf = (message, tag) => fieldOf(message, tag)?.value;
 
