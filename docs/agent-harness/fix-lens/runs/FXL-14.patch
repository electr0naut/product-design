+
+async function start(dark = false, beforeStartup = () => {}) {
+  vi.resetModules();
+  document.documentElement.className = '';
+  document.documentElement.innerHTML = new JSDOM(html).window.document.documentElement.innerHTML;
+  const match = vi.fn(() => ({ matches: dark }));
+  vi.stubGlobal('matchMedia', match);
+  beforeStartup();
+  await import('../src/main.js');
+  return match;
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+test('test_page_without_module_shows_startup_notice', () => {
+  const window = new JSDOM(html).window;
+  const notice = window.document.querySelector('p#not-started');
+  expect(notice.textContent).toBe('FIX Lens did not start. Open it through a web server, not as a file from disk.');
+  expect(notice.closest('[hidden]')).toBeNull();
+  expect(window.getComputedStyle(notice).display).not.toBe('none');
+  expect(window.document.querySelector('main').hidden).toBe(true);
+});
+
+test('test_page_module_startup_reveals_tool', async () => {
+  await start(false, () => {
+    expect(document.querySelector('#not-started')).not.toBeNull();
+    expect(document.querySelector('main').hidden).toBe(true);
+  });
+  expect(document.querySelector('#not-started')).toBeNull();
+  expect(document.querySelector('main').hidden).toBe(false);
+});
+
+test('test_page_theme_follows_system_and_toggles_without_storage', async () => {
+  for (const dark of [false, true, false]) {
+    const match = await start(dark);
+    expect(match).toHaveBeenCalledExactlyOnceWith('(prefers-color-scheme: dark)');
+    const button = document.querySelector('#theme-button');
