+/** Replace generated output without replacing the page's headings. */
+export function render(result) {
+  const summary = document.querySelector('#summary');
+  const timeline = document.querySelector('#timeline');
+  const decode = document.querySelector('#decode');
+  summary.replaceChildren();
+  for (const section of [timeline, decode]) section.replaceChildren(section.firstElementChild);
+
+  if (!result.ok) {
+    add(decode, 'p', 'warning', result.limit.warning);
+    return;
+  }
+  renderStats(summary, result);
+  renderTimeline(timeline, result.timeline);
+  renderMessages(decode, result.decoded, result.errors);
+}
