+function renderCard(section, message) {
+  const card = add(section, 'article', 'card');
+  const head = add(card, 'header', 'card-head');
+  const value = tag => message.fields.find(field => field.tag === tag)?.value;
+  add(head, 'span', 'num', `#${message.number}`);
+  add(head, 'h3', null, message.label.replace(/^Message \d+: /, ''));
+  add(head, 'span', 'dir', direction(value(49), value(56)));
+  add(head, 'span', 'seq', sequence(value(34)));
+  add(head, 'span', 'time', time(value(52)));
+
+  const fields = add(card, 'table', 'fields');
+  const tableHead = add(fields, 'thead');
