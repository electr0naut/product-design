 import { analyse } from './analyse.js';
 import { render } from './render.js';
 
+document.querySelector('#not-started').remove();
+document.querySelector('main').hidden = false;
+
+const themeButton = document.querySelector('#theme-button');
+const systemTheme = window.matchMedia?.('(prefers-color-scheme: dark)');
+let override;
+const isDark = () => override ?? systemTheme?.matches ?? false;
+const updateThemeLabel = () => {
+  themeButton.textContent = isDark() ? 'Light theme' : 'Dark theme';
+};
+updateThemeLabel();
+systemTheme?.addEventListener?.('change', updateThemeLabel);
+themeButton.addEventListener('click', () => {
+  override = !isDark();
+  document.documentElement.className = override ? 'theme-dark' : 'theme-light';
+  updateThemeLabel();
+});
+themeButton.hidden = false;
+
 const input = document.querySelector('#paste');
 document.querySelector('#decode-button').addEventListener('click', () => {
   render(analyse(input.value));
