+function stylesheet() {
+  const source = readFileSync('styles.css', 'utf8');
+  const { window } = new JSDOM();
+  const style = window.document.createElement('style');
+  style.textContent = source;
+  window.document.head.append(style);
+  const rules = [...style.sheet.cssRules];
+  window.close();
+  return { source, rules };
+}
+
+function mediaRules(rules, query) {
+  const rule = rules.find(rule => rule.conditionText === query);
+  expect(rule, query).toBeDefined();
+  return [...rule.cssRules];
+}
+
+function selectorRule(rules, selector) {
+  const rule = rules.find(rule => rule.selectorText === selector);
+  expect(rule, selector).toBeDefined();
+  return rule;
+}
+
+function themeRules(rules) {
+  return [selectorRule(rules, ':root'),
+    selectorRule(mediaRules(rules, '(prefers-color-scheme: dark)'), ':root:not(.theme-light)'),
+    selectorRule(rules, ':root.theme-dark')];
+}
+
+function palette(rule) {
+  return Object.fromEntries(Array.from(rule.style, key => [key, rule.style.getPropertyValue(key).trim()]));
+}
+
+test('test_static_checks_theme_blocks_define_only_named_hex_colours', () => {
+  const { source, rules } = stylesheet();
+  const themes = themeRules(rules).map(palette);
+  const keys = 'bg panel ink muted line soft accent accent-ink ok warn warn-bg bad bad-bg order order-bg session-bg'.split(' ').map(key => `--${key}`).sort();
+  for (const theme of themes) {
+    expect(Object.keys(theme).sort()).toEqual(keys);
+    for (const hex of Object.values(theme)) expect(hex).toMatch(/^#[\da-f]{6}$/i);
+  }
+  expect(themes[1]).toEqual(themes[2]);
+  const outside = source.replace(/^\s*:root(?:\.theme-dark|:not\(\.theme-light\))?\s*\{[^{}]*\}/gm, '');
+  expect(outside).not.toMatch(/#[\da-f]{3,8}\b|\b(?:rgba?|hsla?)\(/i);
+});
+
+function luminance(hex) {
+  const [r, g, b] = hex.slice(1).match(/../g).map(pair => {
+    const component = Number.parseInt(pair, 16) / 255;
+    return component <= 0.04045 ? component / 12.92 : ((component + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+}
+
+test('test_static_checks_theme_pairs_meet_wcag_contrast', () => {
