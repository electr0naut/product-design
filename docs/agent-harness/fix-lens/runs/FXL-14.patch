+    add(row, 'td', null, field.value);
+    add(row, 'td', null, message.supported === false ? '' : field.enumName);
+  }
+}
+
+function renderMessages(section, decoded, errors) {
+  const entries = [...decoded.map(message => ({ number: message.number, message })),
+    ...errors.map(error => ({ number: error.number, error }))];
+  if (!entries.length) add(section, 'p', 'empty', 'No FIX messages found in the pasted text.');
+  for (const { message, error, number } of entries.sort((a, b) => a.number - b.number)) {
+    if (message) {
+      renderCard(section, message);
+    } else {
+      const card = add(section, 'article', 'card malformed');
+      const head = add(card, 'header', 'card-head');
+      add(head, 'span', 'num', `#${number}`);
+      add(head, 'h3', null, 'Malformed message');
+      add(card, 'p', 'error-text', error.text);
