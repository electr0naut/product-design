Subject: [PATCH] FXL-18: Style the order banner, the order links, the trading
 summary and the filters

---
 styles.css          |  63 +++++++++++++++++++++-
 test/styles.test.js | 125 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 187 insertions(+), 1 deletion(-)
 create mode 100644 test/styles.test.js

diff --git a/styles.css b/styles.css
index d36e9d0..193e758 100644
--- a/styles.css
+++ b/styles.css
@@ -125,7 +125,7 @@ button {
   font-variant-numeric: tabular-nums;
 }
 .stat { font-weight: 600; }
-.stat:nth-child(2) { color: var(--ok); }
+.stat:nth-child(2):nth-last-child(4) { color: var(--ok); }
 
 .results {
   display: grid;
@@ -168,3 +168,64 @@ button {
 .empty { color: var(--muted); }
 .error-text, .empty, .warning, #not-started { padding: .7rem .85rem; border-radius: .35rem; }
 .error-text { margin-top: .65rem; }
+
+.order-story, .trades, .filters {
+  margin-top: 1rem;
+  padding: .75rem 1rem;
+  border: 1px solid var(--line);
+  border-radius: .65rem;
+  background: var(--panel);
+}
+.order-story, .filters { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
+.order-story {
+  align-items: baseline;
+  border-color: var(--order);
+  background: var(--order-bg);
+  overflow-wrap: anywhere;
+}
+.order-story strong, .order-link, .trade-table td, .filter select { font-family: ui-monospace, monospace; }
+.order-state { font-weight: 650; }
+.show-all, .clear-filters {
+  margin-left: auto;
+  padding: .3rem .8rem;
+  border-color: var(--line);
+  background: var(--panel);
+  color: var(--ink);
+}
+.order-link {
+  padding: 0 .15rem;
+  border: 0;
+  border-bottom: 1px dashed var(--accent);
+  border-radius: 0;
+  background: none;
+  color: var(--accent);
+  font-size: inherit;
+  text-align: left;
+  overflow-wrap: anywhere;
+}
+.order-link:hover { background: var(--order-bg); color: var(--order); }
+
+.trades { overflow-x: auto; }
+.trade-table { width: 100%; border-collapse: collapse; font-size: .875rem; font-variant-numeric: tabular-nums; }
+.trade-table th, .trade-table td { padding: .35rem .6rem; text-align: right; white-space: nowrap; }
+.trade-table th { border-bottom: 1px solid var(--line); color: var(--muted); font-size: .8rem; }
+.trade-table td { border-top: 1px solid var(--soft); }
+.trade-table th:first-child, .trade-table td:first-child { min-width: 8rem; text-align: left; white-space: normal; overflow-wrap: anywhere; }
+.trade-table td:first-child, .trade-table td:last-child { font-weight: 650; }
+.note { margin-top: .5rem; color: var(--muted); font-size: .8rem; }
+.note.unmatched { color: var(--warn); background: var(--warn-bg); padding: .3rem .6rem; border-radius: .35rem; font-weight: 600; }
+.trades .empty { padding: 0; border: 0; }
+
+.filters { align-items: end; }
+.filter { display: grid; gap: .2rem; min-width: 0; color: var(--muted); font-size: .8rem; }
+.filter select {
+  min-width: 9.5rem;
+  max-width: 100%;
+  padding: .3rem .4rem;
+  border: 1px solid var(--line);
+  border-radius: .35rem;
+  background: var(--bg);
+  color: var(--ink);
+  font-size: .85rem;
+}
+.filter select:disabled { border-style: dashed; color: var(--muted); }
diff --git a/test/styles.test.js b/test/styles.test.js
new file mode 100644
index 0000000..7297738
--- /dev/null
+++ b/test/styles.test.js
@@ -0,0 +1,125 @@
+import { test, expect } from 'vitest';
+import { readFileSync } from 'node:fs';
+
+// The ticket's tests read styles.css as text, the way the existing colour tests do: a helper
+// finds the rule (or rules) whose selector list names a given selector and returns its
+// declarations. Var() values are kept verbatim, so a shorthand such as `background` still reads
+// back what the stylesheet says rather than what a CSS engine would compute.
+function declarations(text) {
+  const found = new Map();
+  for (const part of text.split(';')) {
+    const colon = part.indexOf(':');
+    if (colon === -1) continue;
+    const property = part.slice(0, colon).trim().toLowerCase();
+    const value = part.slice(colon + 1).trim().replace(/\s+/g, ' ');
+    if (property) found.set(property, value);
+  }
+  return found;
+}
+
+function parseRules(source) {
+  const text = source.replace(/\/\*[\s\S]*?\*\//g, '');
+  const rules = [];
+  let prelude = '';
+  for (let index = 0; index < text.length; index += 1) {
+    const char = text[index];
+    if (char === '{') {
+      const selectorText = prelude.trim();
+      prelude = '';
+      if (selectorText.startsWith('@')) continue;
+      const close = text.indexOf('}', index);
+      expect(close, selectorText).toBeGreaterThan(index);
+      rules.push({ selectorText, declarations: declarations(text.slice(index + 1, close)) });
+      index = close;
+      continue;
+    }
+    if (char === '}') {
+      prelude = '';
+      continue;
+    }
+    prelude += char;
+  }
+  return rules;
+}
+
+const rules = parseRules(readFileSync('styles.css', 'utf8'));
+
+function selectors(rule) {
+  return rule.selectorText.split(',').map(part => part.trim().replace(/\s+/g, ' '));
+}
+
+function rulesFor(selector) {
+  return rules.filter(rule => selectors(rule).includes(selector));
+}
+
+function styleFor(selector) {
+  const style = new Map();
+  for (const rule of rulesFor(selector)) for (const [property, value] of rule.declarations) style.set(property, value);
+  return style;
+}
+
+test('test_styles_all_named_classes_have_rules', () => {
+  for (const selector of ['.order-story', '.order-link', '.show-all', '.clear-filters', '.trades',
+    '.trade-table', '.note', '.filters', '.filter']) {
+    expect(rulesFor(selector).length, selector).toBeGreaterThan(0);
+  }
+});
+
+test('test_styles_order_story_is_wrapping_flex_row_with_order_colours', () => {
+  const story = styleFor('.order-story');
+  expect(story.get('display')).toBe('flex');
+  expect(story.get('flex-wrap')).toBe('wrap');
+  expect(story.get('background')).toBe('var(--order-bg)');
+  expect(story.get('border-color')).toBe('var(--order)');
+});
+
+test('test_styles_filters_is_wrapping_flex_row', () => {
+  const filters = styleFor('.filters');
+  expect(filters.get('display')).toBe('flex');
+  expect(filters.get('flex-wrap')).toBe('wrap');
+});
+
+test('test_styles_order_link_looks_not_like_decode_button', () => {
+  const link = styleFor('.order-link');
+  expect(link.get('background')).toBe('none');
+  expect(link.get('border')).toBe('0');
+  expect(link.get('border-bottom')).toMatch(/var\(--accent\)/);
+  expect(link.get('color')).toBe('var(--accent)');
+});
+
+test('test_styles_show_all_and_clear_filters_are_quiet_buttons', () => {
+  for (const selector of ['.show-all', '.clear-filters']) {
+    const style = styleFor(selector);
+    expect(style.get('background'), selector).toBe('var(--panel)');
+    expect(style.get('color'), selector).toBe('var(--ink)');
+  }
+});
+
+test('test_styles_trades_scrolls_horizontally', () => {
+  expect(styleFor('.trades').get('overflow-x')).toBe('auto');
+});
+
+test('test_styles_trade_table_collapses_borders_and_aligns_right', () => {
+  expect(styleFor('.trade-table').get('border-collapse')).toBe('collapse');
+  expect(styleFor('.trade-table th').get('text-align')).toBe('right');
+  expect(styleFor('.trade-table td').get('text-align')).toBe('right');
+});
+
+test('test_styles_trade_table_first_cell_aligns_left', () => {
+  expect(styleFor('.trade-table th:first-child').get('text-align')).toBe('left');
+  expect(styleFor('.trade-table td:first-child').get('text-align')).toBe('left');
+});
+
+test('test_styles_filter_select_and_filter_constrain_width', () => {
+  expect(styleFor('.filter select').get('max-width')).toBe('100%');
+  expect(styleFor('.filter').get('min-width')).toBe('0');
+});
+
+test('test_styles_stat_second_child_not_green_alone', () => {
+  expect(rulesFor('.stat:nth-child(2)')).toHaveLength(0);
+});
+
+test('test_styles_stat_second_of_four_is_green', () => {
+  expect(rulesFor('.stat:nth-child(2):nth-last-child(4)').length).toBeGreaterThan(0);
+  expect(styleFor('.stat:nth-child(2):nth-last-child(4)').get('color')).toBe('var(--ok)');
+});
