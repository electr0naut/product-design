+import { describe, it, expect } from "vitest";
+import { splitMessages, checkMessage } from "../src/framing.js";
+import { buildMessage } from "./helpers/fix.js";
+
+// Helper to get the first candidate from a message
+function firstCandidate(msg) {
+  const candidates = splitMessages(msg);
+  expect(candidates.length).toBeGreaterThan(0);
+  return candidates[0];
+}
+
+describe("AC1: valid messages", () => {
+  it("returns null for a valid message with pipe delimiter", () => {
+    const msg = buildMessage([
+      [8, "FIX.4.2"],
+      [35, "0"],
+      [49, "SENDER"],
+      [56, "TARGET"],
+    ]);
+    const candidate = firstCandidate(msg);
+    expect(checkMessage(candidate, msg)).toBeNull();
+  });
+
+  it("returns null for a valid message with SOH delimiter", () => {
+    const msg = buildMessage(
+      [
+        [8, "FIX.4.2"],
+        [35, "0"],
+        [49, "SENDER"],
+      ],
+      { delim: "\x01" }
+    );
+    const candidate = firstCandidate(msg);
+    expect(checkMessage(candidate, msg)).toBeNull();
+  });
+});
+
+describe("AC2: individual rules", () => {
+  it("detects field_without_equals for a field missing equals sign", () => {
+    // Construct a message with a field that has no '='
+    const msg = "8=FIX.4.2|9=5|35A|10=000|";
+    const candidates = splitMessages(msg);
+    // splitMessages skips fields without '=', so candidate may have fewer fields
+    // We need to construct a candidate manually or use a message where splitMessages still produces a candidate
+    // Actually, splitMessages will skip 35A and continue. Let's use a different approach.
+    // Build a valid message, then replace a field to remove '='
+    const valid = buildMessage([[8, "FIX.4.2"], [35, "0"]]);
+    // Replace "35=0" with "35A" (no equals)
+    const malformed = valid.replace("35=0", "35A");
+    const cands = splitMessages(malformed);
+    // splitMessages will skip 35A, so candidate has [8, 9, 10]
+    // But we need to test checkMessage on this
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], malformed);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("field_without_equals");
+    }
+  });
+
+  it("detects field_without_equals for empty field from ||", () => {
+    // A message with || creates an empty field
+    const msg = "8=FIX.4.2|9=5|35=0||10=000|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("field_without_equals");
+    }
+  });
+
+  it("detects bad_tag for tag 0", () => {
+    const msg = buildMessage([[8, "FIX.4.2"], [0, "xxx"], [35, "0"]]);
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("bad_tag");
+    }
+  });
+
+  it("detects bad_tag for negative tag", () => {
+    const msg = buildMessage([[8, "FIX.4.2"], [-5, "xxx"], [35, "0"]]);
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("bad_tag");
+    }
+  });
+
+  it("detects bad_tag for tag with leading zero", () => {
+    // Manually construct message with "07=xxx" since buildMessage converts to Number
+    const msg = "8=FIX.4.2|9=12|07=xxx|35=0|10=000|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("bad_tag");
+    }
+  });
+
+  it("detects bad_tag for non-numeric tag", () => {
+    const msg = buildMessage([[8, "FIX.4.2"], ["ab", "xxx"], [35, "0"]]);
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("bad_tag");
+    }
+  });
+
+  it("detects header_order for fewer than three fields", () => {
+    // Build a message with only 2 fields (8 and 10)
+    const msg = "8=FIX.4.2|10=000|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("header_order");
+    }
+  });
+
+  it("detects header_order for wrong first three tags", () => {
+    const msg = buildMessage([[8, "FIX.4.2"], [35, "0"], [49, "SENDER"]]);
+    // Swap tags 9 and 35 positions
+    const malformed = msg.replace("9=", "35=").replace("35=0", "9=0");
+    const cands = splitMessages(malformed);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], malformed);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("header_order");
+    }
+  });
+
+  it("detects missing_checksum when no tag 10 at end", () => {
+    const msg = "8=FIX.4.2|9=5|35=0|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("missing_checksum");
+    }
+  });
+
+  it("detects checksum_format for 10=12", () => {
+    const msg = "8=FIX.4.2|9=5|35=0|10=12|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("checksum_format");
+    }
+  });
+
+  it("detects checksum_format for 10=ABC", () => {
+    const msg = "8=FIX.4.2|9=5|35=0|10=ABC|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("checksum_format");
+    }
+  });
+
+  it("detects body_length when tag 9 is not a number", () => {
+    const msg = "8=FIX.4.2|9=abc|35=0|10=000|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("body_length");
+    }
+  });
+
+  it("detects body_length when tag 9 value is wrong", () => {
+    const msg = buildMessage([[8, "FIX.4.2"], [35, "0"]]);
+    // Change the body length value
+    const malformed = msg.replace(/9=\d+/, "9=999");
+    const cands = splitMessages(malformed);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], malformed);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("body_length");
+      expect(result.text).toMatch(/BodyLength \(9\) says \d+, actual \d+ at position \d+/);
+    }
+  });
+
+  it("detects checksum when tag 10 value is wrong", () => {
+    const msg = buildMessage([[8, "FIX.4.2"], [35, "0"]]);
+    // Change the checksum value
+    const malformed = msg.replace(/10=\d{3}/, "10=999");
+    const cands = splitMessages(malformed);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], malformed);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("checksum");
+    }
+  });
+});
+
+describe("AC3: rule priority", () => {
+  it("reports only the first failing rule when multiple rules fail", () => {
+    // Message with both field_without_equals and bad_tag
+    const msg = "8=FIX.4.2|9=5|35A|0=xxx|10=000|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("field_without_equals");
+    }
+  });
+
+  it("reports bad_tag before header_order when both fail", () => {
+    // Message with bad_tag and wrong header order
+    const msg = "8=FIX.4.2|0=xxx|35=0|10=000|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("bad_tag");
+    }
+  });
+});
+
+describe("AC4: UTF-8 byte counting", () => {
+  it("BodyLength and CheckSum count UTF-8 bytes for non-ASCII characters", () => {
+    // Build a message with a non-ASCII character in tag 58
+    const msg = buildMessage([
+      [8, "FIX.4.2"],
+      [35, "0"],
+      [58, "ñ"], // ñ is 2 bytes in UTF-8
+    ]);
+    const candidate = firstCandidate(msg);
+    // Should be valid because BodyLength and CheckSum count UTF-8 bytes
+    expect(checkMessage(candidate, msg)).toBeNull();
+  });
+});
+
+describe("AC5: position calculation", () => {
+  it("position is 1-based character position in original text", () => {
+    const msg = "8=FIX.4.2|9=5|0=xxx|35=0|10=000|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      // Position should be 1-based index of the field's first character
+      expect(result.position).toBeGreaterThan(0);
+      expect(typeof result.position).toBe("number");
+    }
+  });
+
+  it("position for missing CheckSum is end of candidate", () => {
+    const msg = "8=FIX.4.2|9=5|35=0|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("missing_checksum");
+      expect(result.position).toBeGreaterThan(0);
+    }
+  });
+});
+
+describe("AC6: error text format", () => {
+  it("error text follows 'Message N: <problem> at position P' format", () => {
+    const msg = "8=FIX.4.2|9=5|0=xxx|35=0|10=000|";
+    const cands = splitMessages(msg);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], msg);
+      expect(result).not.toBeNull();
+      expect(result.text).toMatch(/^Message \d+: .+ at position \d+$/);
+    }
+  });
+
+  it("BodyLength error text includes expected and actual values", () => {
+    const msg = buildMessage([[8, "FIX.4.2"], [35, "0"]]);
+    const malformed = msg.replace(/9=\d+/, "9=999");
+    const cands = splitMessages(malformed);
+    if (cands.length > 0) {
+      const result = checkMessage(cands[0], malformed);
+      expect(result).not.toBeNull();
+      expect(result.rule).toBe("body_length");
+      expect(result.text).toMatch(/BodyLength \(9\) says \d+, actual \d+ at position \d+/);
+    }
+  });
+});
