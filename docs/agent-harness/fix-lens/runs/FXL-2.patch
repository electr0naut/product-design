+/**
+ * checkMessage(candidate, text) -> null | {number, position, rule, text}
+ *
+ * Validates a parsed FIX message candidate. Returns null for valid messages,
+ * or an error object for the first failing rule (in priority order).
+ *
+ * candidate: {number, start, fields} from splitMessages
+ * text: the original pasted text
+ *
+ * Rules checked in priority order:
+ * 1. field_without_equals - any field missing '=' including empty fields
+ * 2. bad_tag - tag is 0, negative, has leading zero, or non-numeric
+ * 3. header_order - fewer than 3 fields or first three tags not 8, 9, 35
+ * 4. missing_checksum - no field with tag 10 at the end
+ * 5. checksum_format - tag 10 value is not exactly 3 digits
+ * 6. body_length - tag 9 value is not a number or doesn't match actual body byte length
+ * 7. checksum - tag 10 value doesn't match computed checksum
+ */
+export function checkMessage(candidate, text) {
+  const { number, start, fields } = candidate;
+
+  // Re-parse the raw text from candidate.start to find ALL fields (including malformed).
+  const delim = detectDelimiter(text, start);
+  const rawFields = [];
+  let cursor = start;
+
+  while (cursor < text.length) {
+    const fieldEnd = findFieldEnd(text, cursor, delim);
+    const fieldText = text.substring(cursor, fieldEnd);
+
+    // Stop at line ends
+    if (fieldEnd < text.length) {
+      const sep = text[fieldEnd];
+      if (sep === "\n" || sep === "\r") break;
+    }
+
+    // Empty field after delimiter (like from ||) - include it so field_without_equals can detect it
+    if (fieldText === "") {
+      // Check if this is the final empty field after the last delimiter
+      if (fieldEnd >= text.length) break;
+      const sep = text[fieldEnd];
+      if (sep !== delim) break;
+      // This is an empty field between delimiters (like ||)
+      rawFields.push({ text: fieldText, offset: cursor });
+      cursor = fieldEnd + 1;
+      continue;
+    }
+
+    rawFields.push({ text: fieldText, offset: cursor });
+
+    if (fieldEnd >= text.length) break;
+    const sep = text[fieldEnd];
+    if (sep === delim) {
+      cursor = fieldEnd + 1;
+    } else {
+      break;
+    }
+  }
+
+  // Rule 1: field_without_equals
+  for (const field of rawFields) {
+    if (!field.text.includes("=")) {
+      return {
+        number,
+        position: field.offset + 1,
+        rule: "field_without_equals",
+        text: `Message ${number}: field without '=' at position ${field.offset + 1}`,
+      };
+    }
+  }
+
+  // Rule 2: bad_tag
+  for (const field of rawFields) {
+    const eqIdx = field.text.indexOf("=");
+    const tagStr = field.text.substring(0, eqIdx);
+
+    // Non-numeric tag (including negative like -5)
+    if (!/^\d+$/.test(tagStr)) {
+      return {
+        number,
+        position: field.offset + 1,
+        rule: "bad_tag",
+        text: `Message ${number}: bad tag '${tagStr}' at position ${field.offset + 1}`,
+      };
+    }
+
+    // Tag 0
+    if (tagStr === "0") {
+      return {
+        number,
+        position: field.offset + 1,
+        rule: "bad_tag",
+        text: `Message ${number}: bad tag '0' at position ${field.offset + 1}`,
+      };
+    }
+
+    // Leading zero (e.g. '07')
+    if (tagStr.length > 1 && tagStr[0] === "0") {
+      return {
+        number,
+        position: field.offset + 1,
+        rule: "bad_tag",
+        text: `Message ${number}: bad tag '${tagStr}' at position ${field.offset + 1}`,
+      };
+    }
+  }
+
+  // Rule 3: header_order
+  if (fields.length < 3) {
+    return {
+      number,
+      position: fields[0].offset + 1,
+      rule: "header_order",
+      text: `Message ${number}: header order wrong at position ${fields[0].offset + 1}`,
+    };
+  }
+
+  if (fields[0].tag !== 8 || fields[1].tag !== 9 || fields[2].tag !== 35) {
+    let wrongIdx = 0;
+    if (fields[0].tag !== 8) wrongIdx = 0;
+    else if (fields[1].tag !== 9) wrongIdx = 1;
+    else wrongIdx = 2;
+
+    return {
+      number,
+      position: fields[wrongIdx].offset + 1,
+      rule: "header_order",
+      text: `Message ${number}: header order wrong at position ${fields[wrongIdx].offset + 1}`,
+    };
+  }
+
+  // Rule 4: missing_checksum
+  const lastField = fields[fields.length - 1];
+  if (lastField.tag !== 10) {
+    // Position is end of candidate (after last field + delimiter)
+    const lastFieldEnd = lastField.offset + String(lastField.tag).length + 1 + lastField.value.length;
+    return {
+      number,
+      position: lastFieldEnd + 1,
+      rule: "missing_checksum",
+      text: `Message ${number}: missing CheckSum (tag 10) at position ${lastFieldEnd + 1}`,
+    };
+  }
+
+  // Rule 5: checksum_format
+  if (!/^\d{3}$/.test(lastField.value)) {
+    return {
+      number,
+      position: lastField.offset + 1,
+      rule: "checksum_format",
+      text: `Message ${number}: CheckSum format wrong at position ${lastField.offset + 1}`,
+    };
+  }
+
+  // Rule 6: body_length
+  const bodyLengthField = fields.find(f => f.tag === 9);
+  if (!bodyLengthField || !/^\d+$/.test(bodyLengthField.value)) {
+    const pos = bodyLengthField ? bodyLengthField.offset + 1 : fields[0].offset + 1;
+    return {
+      number,
+      position: pos,
+      rule: "body_length",
+      text: `Message ${number}: BodyLength (9) not a number at position ${pos}`,
+    };
+  }
+
+  // Calculate actual body length in bytes (UTF-8)
+  // Body starts AFTER the delimiter following 9=<len>
+  const bodyStart = bodyLengthField.offset + String(bodyLengthField.tag).length + 1 + bodyLengthField.value.length + 1;
+  const bodyEnd = lastField.offset;
+  const bodyText = text.substring(bodyStart, bodyEnd);
+  const actualBodyLength = new TextEncoder().encode(bodyText).length;
+  const expectedBodyLength = Number(bodyLengthField.value);
+
+  if (actualBodyLength !== expectedBodyLength) {
+    return {
+      number,
+      position: bodyLengthField.offset + 1,
+      rule: "body_length",
+      text: `Message ${number}: BodyLength (9) says ${expectedBodyLength}, actual ${actualBodyLength} at position ${bodyLengthField.offset + 1}`,
+    };
+  }
+
+  // Rule 7: checksum
+  const msgBeforeChecksum = text.substring(start, lastField.offset);
+  const bytes = new TextEncoder().encode(msgBeforeChecksum);
+  let sum = 0;
+  for (const b of bytes) sum += b;
+  const expectedChecksum = (sum % 256).toString().padStart(3, "0");
+
+  if (lastField.value !== expectedChecksum) {
+    return {
+      number,
+      position: lastField.offset + 1,
+      rule: "checksum",
+      text: `Message ${number}: CheckSum mismatch at position ${lastField.offset + 1}`,
+    };
+  }
+
+  // All rules passed
+  return null;
+}
