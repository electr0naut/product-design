{
 "chromium": "1.63.0",
 "tests": [
  {
   "id": "BR-01",
   "feature": "The page starts over HTTP, removes the not-started message, and requests only its own files",
   "version": "FIX.4.2 + FIX.4.4",
   "dataset": "built in tests/browser_test.cjs",
   "expected": {
    "notStarted": false,
    "mainHidden": false,
    "foreignRequests": 0,
    "consoleErrors": 0
   },
   "actual": {
    "notStarted": false,
    "mainHidden": false,
    "csp": "default-src 'self'; connect-src 'none'; form-action 'none'",
    "foreignRequests": [],
    "consoleErrors": [],
    "requests": 16
   },
   "status": "PASS"
  },
  {
   "id": "BR-02",
   "feature": "Opened from disk: the not-started message is shown in place of the tool (AC-024)",
   "version": "FIX.4.2 + FIX.4.4",
   "dataset": "built in tests/browser_test.cjs",
   "expected": "message visible, tool hidden",
   "actual": {
    "text": "FIX Lens did not start. Open it through a web server, not as a file from disk.",
    "visible": true,
    "mainHidden": true
   },
   "status": "PASS"
  },
  {
   "id": "BR-03",
   "feature": "Raw SOH text pasted into the textarea (clipboard) keeps every SOH and decodes to the ground-truth counts",
   "version": "FIX.4.4",
   "dataset": "datasets/FIX44/lifecycle-44.log",
   "expected": {
    "soh": 6663,
    "stats": [
     "328 messages",
     "328 valid",
     "0 malformed",
     "2 sequence gaps",
     "45 orders"
    ]
   },
   "actual": {
    "soh": 6663,
    "stats": [
     "328 messages",
     "328 valid",
     "0 malformed",
     "2 sequence gaps",
     "45 orders"
    ]
   },
   "status": "PASS"
  },
  {
   "id": "BR-04",
   "feature": "Windows CRLF text gives the same counts",
   "version": "FIX.4.4",
   "dataset": "datasets/FIX44/lifecycle-44.log",
   "expected": [
    "328 messages",
    "328 valid",
    "0 malformed",
    "2 sequence gaps",
    "45 orders"
   ],
   "actual": [
    "328 messages",
    "328 valid",
    "0 malformed",
    "2 sequence gaps",
    "45 orders"
   ],
   "status": "PASS"
  },
  {
   "id": "BR-05",
   "feature": "Trading summary table in the browser equals the decimal ground truth (845 messages, 5 sessions)",
