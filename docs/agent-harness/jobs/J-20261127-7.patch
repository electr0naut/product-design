+def test_the_calls_of_one_card_are_capped():
+    s = fallback.settings({"review": {"fallback": {**ON, "max_calls_per_card": 2}}})
+    call = Model('{"a": 1}', '{"a": 1}', '{"a": 1}').call(s)
+    call("q", SCHEMA)
+    call("q", SCHEMA)
+    with pytest.raises(FallbackFault, match="2 calls for this card, the limit"):
+        call("q", SCHEMA)
