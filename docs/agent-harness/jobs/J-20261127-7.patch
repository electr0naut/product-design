@@ -0,0 +1,325 @@
+"""D27 part 2: a review on a second model while Claude is at its usage limit.
+
+Off unless `[review.fallback] enabled = true`. When Claude refuses a review call for a usage limit
+(part 1 decides what a limit is; nothing else leads here), the review is run again from its start
+with every Claude step answered by one Hermes profile instead. One reviewer per review, never half
+and half. The switch is refused, and the card waits for Claude as in part 1, when:
+
+- the limit's named reset is `switch_after_minutes` away or less (no readable reset: switch);
+- the ticket is in the high tier;
+- the fallback model planned, implemented or found in this ticket, or that cannot be established;
+- the profile is not exactly one model with no fallback of its own;
+- a fallback review was already tried during this wait.
+
+Anything that goes wrong on the fallback (a refused or malformed answer after one re-ask, a tool
+call, another model than the intended one, a time-out, too many calls, sources too large for one
+prompt) is a fault of the fallback: nothing lands and the card waits for Claude.
+
+The model gets text and returns text. It has no file tool: the host puts the sources at the
+reviewed commit into the prompt, and for the prove step writes the test the model returns into one
+new file. The design, the ticket and the sources go to the fallback's provider, as they do when a
+model of that provider plans or implements.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import subprocess
+import time
+from collections.abc import Callable
+from dataclasses import dataclass
+
+from . import HarnessError
+
+NO_TOOLS = (
+    "You have no tools and cannot open files or run anything. Where the instructions below say "
+    "that the repository is your working directory or that you can read files, use the sources "
+    "printed at the end instead: they are the whole repository at the change, apart from the "
+    "files listed as left out.\n\n"
+)
+Ask = Callable[[str], tuple[int, str, str]]  # text in; exit code, stdout, stderr
+Check = Callable[[float], dict]  # start time in; what the profile's sessions since then did
+
+
+PROVE_NOTE = (
+    " Put the whole source of that file in test_source: it will be written for you, to a file "
+    "that does not exist yet. That you cannot run the test is no reason to fill "
+    "could_not_prove_because; fill it only when no test can show the finding."
+)
+
+
+class FallbackFault(HarnessError):
+    """The fallback could not give a usable answer. The review waits for Claude."""
+
+
+@dataclass(frozen=True)
+class Settings:
+    enabled: bool
+    profile: str
+    model: str
+    switch_after_s: float
+    max_calls: int
+    timeout_s: int
+    pack_max_chars: int
+    author_profiles: tuple[str, ...]
+
+
+def settings(cfg: dict) -> Settings:
+    f = cfg.get("review", {}).get("fallback", {})
+    return Settings(
+        enabled=bool(f.get("enabled", False)),
+        profile=str(f.get("profile", "reviewer-fallback")),
+        model=str(f.get("model", "")),
+        switch_after_s=float(f.get("switch_after_minutes", 60)) * 60,
+        max_calls=int(f.get("max_calls_per_card", 12)),
+        timeout_s=int(f.get("timeout_s", 900)),
+        pack_max_chars=int(f.get("pack_max_chars", 200000)),
+        author_profiles=tuple(
+            f.get("author_profiles", ["triage", "planner", "implementer", "reviewer"])
+        ),
+    )
+
+
+@dataclass(frozen=True)
+class Second:
+    """The second reviewer, as the runner uses it."""
+
+    settings: Settings
+    call: Callable[[str, dict], dict]
+    used: Callable[[float], dict | None]  # the authors' models since a time
+    profiles: Callable[[list[str]], dict]  # name -> {"default", "fallbacks"} or {"error"}
+
+
+def proof_schema(schema: dict) -> dict:
+    """The proof answer plus the test's source, which the host writes."""
+    return {
+        **schema,
+        "properties": {**schema["properties"], "test_source": {"type": "string"}},
+        "required": [*schema["required"], "test_source"],
+    }
+
+
+def said(review: dict) -> str:
+    """Empty for a review by Claude; else the words every report of the review carries."""
+    who = review.get("reviewer")
+    if not who:
+        return ""
+    since = time.strftime("%Y-%m-%d %H:%M %z", time.localtime(who["claude_limited_since"]))
+    authors = ", ".join(who.get("authors_models", [])) or "none recorded"
+    return (
+        f" (reviewed on the fallback model {who['fallback_model']}, Claude at its usage limit "
+        f"since {since}; the ticket's authors ran on: {authors})"
+    )
+
+
+def should_switch(resets_at: float | None, now: float, s: Settings) -> bool:
+    """A reset that is near keeps Claude as the reviewer. No readable reset: switch."""
+    return resets_at is None or resets_at - now > s.switch_after_s
+
+
+def profile_refusal(s: Settings, profiles: dict) -> str | None:
+    """The profile must be the one model and nothing else, so no call can move silently."""
+    p = profiles.get(s.profile, {"error": "not read"})
+    if "error" in p:
+        return f"the profile {s.profile} could not be read: {p['error']}"
+    if not s.model or p.get("default") != s.model:
+        return f"the profile {s.profile} runs {p.get('default')!r}, not {s.model!r}"
+    if p.get("fallbacks"):
+        return f"the profile {s.profile} has fallbacks of its own: {', '.join(p['fallbacks'])}"
+    return None
+
+
+def independence_refusal(s: Settings, used: dict | None) -> str | None:
+    """`used`: {"models": [...], "unknown": [...]} for the ticket's authors, or None."""
+    if used is None:
+        return "the models this ticket used could not be established"
+    if used.get("unknown"):
+        return "a model switch in this ticket names no model: " + ", ".join(used["unknown"])
+    if s.model in used.get("models", []):
+        return f"{s.model} planned, implemented or found in this ticket"
+    return None
+
+
+def source_pack(git: Callable[..., str], sha: str, left_out: Callable[[str], bool], limit: int):
+    """The text files at `sha`, each under its path, and the names of what was left out."""
+    names = [n for n in git("ls-tree", "-r", "--name-only", "-z", sha).split("\0") if n]
+    parts, skipped, size = [], [], 0
+    for name in names:
+        if left_out(name):
+            skipped.append(name)
+            continue
+        try:
+            text = git("show", f"{sha}:{name}")
+        except (HarnessError, UnicodeDecodeError):
+            skipped.append(name)  # not text, or not a file (a submodule)
+            continue
+        if "\0" in text:
+            skipped.append(name)
+            continue
+        size += len(text)
+        if size > limit:
+            raise FallbackFault(
+                f"the sources at the change are over {limit} characters, too large for one prompt"
+            )
+        parts.append(f"\n\n--- File: {name} ---\n{text}")
+    note = (
+        f"\n\nLeft out (generated, vendored or not text): {', '.join(skipped)}." if skipped else ""
+    )
+    return "\n\n=== The repository at the change ===" + "".join(parts) + note
+
+
+def make_call(s: Settings, ask: Ask, check: Check, parse, validate, clock=time.time):
+    """`call(prompt, schema) -> answer`: one question, at most one re-ask, every answer checked.
+
+    `parse(text)` gives the JSON objects in a reply and `validate(obj, schema)` raises on a wrong
+    shape (the reviewer's own two functions). After every exchange the profile's sessions since
+    its start are read: a tool call, or any model but the intended one, discards the answer.
+    """
+    calls = 0
+
+    def call(prompt: str, schema: dict) -> dict:
+        nonlocal calls
+        why = ""
+        for n in (1, 2):
+            if calls >= s.max_calls:
+                raise FallbackFault(f"the fallback made {calls} calls for this card, the limit")
+            calls += 1
+            text = (
+                prompt
+                + "\n\nOutput ONLY one JSON object that matches this schema, with no prose and no "
+                "code fence:\n" + json.dumps(schema)
+            )
+            if n == 2:
+                text += (
+                    f"\n\nYour previous reply was rejected: {why}. Reply with only the JSON object."
+                )
+            start = clock()
+            try:
+                code, out, err = ask(text)
+            except subprocess.TimeoutExpired as exc:
+                raise FallbackFault(f"the fallback timed out after {s.timeout_s} s") from exc
+            except OSError as exc:
+                raise FallbackFault(f"the fallback could not be started: {exc}") from exc
+            if code != 0:
+                raise FallbackFault(f"the fallback call failed ({code}): {err.strip()[-200:]}")
+            seen = check(start)
+            if seen.get("tool_calls"):
+                raise FallbackFault(f"the fallback made {seen['tool_calls']} tool call(s)")
+            if seen.get("models") != [s.model]:
+                raise FallbackFault(
+                    f"the fallback ran on {seen.get('models')}, not on {s.model} alone"
+                )
+            why = "no JSON object in the reply"
+            for obj in parse(out):
+                try:
+                    validate(obj, schema)
+                except HarnessError as exc:
+                    why = str(exc)
+                    continue
+                return obj
+        raise FallbackFault(f"the fallback's reply is invalid after one re-ask: {why}")
+
+    return call
+
+
+# ---------- real backends ----------
+
+_IN_CONTAINER = ["docker", "exec", "-i", "-u", "hermes"]
+
+
+def hermes_ask(s: Settings) -> Ask:
+    """One question to the profile: no tool set, no rules file, one turn and a spare."""
+
+    def ask(text: str) -> tuple[int, str, str]:
+        p = subprocess.run(
+            [*_IN_CONTAINER, "-w", "/tmp", "hermes", "hermes", "-p", s.profile, "chat",
+             "--query-file", "-", "--oneshot", "-Q", "-t", "context_engine", "--ignore-rules",
+             "--max-turns", "2"],
+            input=text, capture_output=True, text=True, check=False, timeout=s.timeout_s,
+        )  # fmt: skip
+        return p.returncode, p.stdout, p.stderr
+
+    return ask
+
+
+_SESSIONS = (
+    "import json,sqlite3\n"
+    "c=sqlite3.connect('file:/opt/data/profiles/NAME/state.db?mode=ro',uri=True)\n"
+    "rows=list(c.execute('select model,coalesce(tool_call_count,0) from sessions '\n"
+    "    'where started_at>=?',(T0,)))\n"
+    "print(json.dumps({'models':sorted({r[0] or '' for r in rows}),"
+    "'tool_calls':sum(r[1] for r in rows),'sessions':len(rows)}))"
+)
+_USED = r"""
+import json, re, sqlite3, time
+models, unknown = set(), []
+for name in NAMES:
+    root = Path('/opt/data/profiles') / name
+    con = sqlite3.connect(f'file:{root}/state.db?mode=ro', uri=True)
+    models |= {r[0] for r in con.execute(
+        'select distinct model from sessions where started_at>=?', (T0,)) if r[0]}
+    con.close()
+    log = root / 'logs' / 'agent.log'
+    if not log.exists():
+        continue
+    for line in log.read_text(errors='replace').splitlines():
+        if 'Fallback activated:' not in line:
+            continue
+        at = re.match(r'(\d{4}-\d\d-\d\d)[ T](\d\d:\d\d:\d\d)', line)
+        if at and time.mktime(time.strptime(' '.join(at.groups()), '%Y-%m-%d %H:%M:%S')) < T0:
+            continue
+        to = re.search(r'Fallback activated: .*?(?:→|->)\s*(\S+)', line)
+        if to:
+            models.add(to.group(1))
+        else:
+            unknown.append(name)
+print(json.dumps({'models': sorted(models), 'unknown': unknown}))
+"""
+
+
+def _python_in_container(code: str) -> dict:
+    p = subprocess.run(
+        [*_IN_CONTAINER, "hermes", "python3", "-I", "-c", code],
+        capture_output=True, text=True, check=False, timeout=120,
+    )  # fmt: skip
+    if p.returncode != 0:
+        raise FallbackFault(f"Hermes's records could not be read ({p.returncode})")
+    try:
+        return json.loads(p.stdout)
+    except ValueError as exc:
+        raise FallbackFault("Hermes's records gave no JSON") from exc
+
+
+def _name(profile: str) -> str:
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", profile):
+        raise FallbackFault(f"not a profile name: {profile!r}")
+    return profile
+
+
+def hermes_check(s: Settings) -> Check:
+    """Models and tool calls of the profile's sessions since a call began (one or more)."""
+
+    def check(start: float) -> dict:
+        code = _SESSIONS.replace("NAME", _name(s.profile)).replace("T0", repr(float(start) - 1))
+        seen = _python_in_container(code)
+        if not seen.get("sessions"):
+            raise FallbackFault("the fallback's call left no session to check")
+        return seen
+
+    return check
+
+
+def hermes_used(s: Settings) -> Callable[[float], dict | None]:
+    """The models of the ticket's authors since `t0`: every session's model, and every model a
+    profile's log says it fell back to. None when that cannot be read."""
+
+    def used(t0: float) -> dict | None:
+        names = [_name(n) for n in s.author_profiles]
+        code = _USED.replace("NAMES", repr(names)).replace("T0", repr(float(t0)))
+        try:
+            return _python_in_container(code)
+        except (FallbackFault, OSError, subprocess.SubprocessError):
+            return None
+
+    return used
