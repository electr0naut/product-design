+
+@pytest.mark.parametrize(
+    ("profile", "word"),
+    [
+        ({"default": MODEL, "fallbacks": []}, None),
+        ({"default": "qwen3.7-plus", "fallbacks": []}, "runs 'qwen3.7-plus'"),
+        ({"default": MODEL, "fallbacks": ["deepseek (x)"]}, "fallbacks of its own"),
+        ({"error": "config get failed"}, "could not be read"),
