+"""D27 part 2: while Claude is at its usage limit, a second model may review; never silently."""
+
+import json
+import subprocess
+
+import pytest
+from test_d27 import T0, Board, Clock, Script
+from test_reviewer import FINDING, git, world  # noqa: F401
+
+from harness import HarnessError, claude_wait, evidence, fallback, pipeline, reviewer, trusted
+from harness.claude_wait import ClaudeLimit
+from harness.fallback import FallbackFault
+
+MODEL = "qwen4-max"
+ON = {"enabled": True, "model": MODEL}
+S = fallback.settings({"review": {"fallback": ON}})
+FAR = ClaudeLimit("usage limit (five_hour)", T0 + 3 * 3600)
+NEAR = ClaudeLimit("usage limit (five_hour)", T0 + 3600)
+SCHEMA = {
+    "type": "object",
+    "properties": {"a": {"type": "integer"}},
+    "required": ["a"],
+    "additionalProperties": False,
+}
+SEEN = {"models": [MODEL], "tool_calls": 0, "sessions": 1}
