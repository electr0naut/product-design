+# --- the runner ---
+
+PROFILE_OK = {"default": MODEL, "fallbacks": []}
+AUTHORS = {"models": ["gpt-6.2-sol", "qwen3.7-plus"], "unknown": []}
+TEST = "def test_half():\n    assert False\n"
+
+
+class SecondModel:
+    """Answers the review's steps as the second model would: text in, an object out."""
+
+    def __init__(self, verdict="refuted", fail=None, proof=None):
+        self.verdict, self.fail, self.proof, self.asked = verdict, fail, proof or {}, []
+
+    def __call__(self, prompt, schema):
+        self.asked.append(prompt)
+        if self.fail:
+            raise self.fail
+        if "refutations" in schema["properties"]:
+            return {
+                "refutations": [
+                    {"finding_id": "F1", "verdict": self.verdict, "reason": "r",
+                     "counter_evidence": "c"}
+                ]
+            }  # fmt: skip
+        return {
+            "finding_id": "F1", "test_id": "tests/test_proof.py::test_half",
+            "test_file": "tests/test_proof.py", "could_not_prove_because": "",
+            "test_source": TEST, **self.proof,
+        }  # fmt: skip
+
+
+class Rig2:
+    def __init__(self, world, *failures, second=None, on=ON, profile=PROFILE_OK, used=AUTHORS):
+        kit, repo, run, cfg = world
+        self.world, self.board, self.clock = world, Board(), Clock()
+        self.claude, self.model = Script(*failures), second or SecondModel()
+        self.root = kit.parent / "trusted"
+        self.cfg = {**cfg, "review": {**cfg["review"], "fallback": on}}
+        self.asked_profiles, self.asked_used = [], []
+        self.profile, self.used = profile, used
+        self.alerts, self.events = [], []
+        pipeline.registry_path(self.root).write_text(
+            json.dumps([{"key": "PRC-1", "loaded_at": T0 - 500}])
+        )
+        self.main = git(trusted.trusted_repo(repo, self.root), "rev-parse", "main")
+
+    def profiles(self, names):
+        self.asked_profiles.append(names)
+        return {n: self.profile for n in names}
+
+    def authors(self, t0):
+        self.asked_used.append(t0)
+        return self.used
+
+    def run(self):
+        kit, repo, run, _ = self.world
+        find = lambda prompt: json.dumps({"findings": [FINDING]})  # noqa: E731
+        s = fallback.settings(self.cfg)
+        r = reviewer.Runner(
+            self.cfg, self.board, find, self.claude, repo, kit, self.root,
+            send=self.alerts.append, clock=self.clock,
+            second=fallback.Second(s, self.model, self.authors, self.profiles),
+        )  # fmt: skip
+        out = r.run_once()
+        self.events, self.last = self.events + r.events, r
+        return out
+
+    def landed(self):
+        repo = self.world[1]
+        return git(trusted.trusted_repo(repo, self.root), "rev-parse", "main") != self.main
+
+    def review(self):
+        return json.loads((self.world[2] / "review.json").read_text())
+
+    def wait(self):
+        return claude_wait.read(self.root).get("t_9")
+
+
+def test_a_far_limit_moves_the_whole_review_to_the_second_model_and_says_so(world):
+    rig = Rig2(world, FAR)
+    assert rig.run() == "completed t_9"
+    assert rig.landed() and rig.wait() is None and rig.claude.calls == 1
+    who = rig.review()["reviewer"]
+    assert who == {
+        "fallback_model": MODEL, "claude_limited_since": T0,
+        "authors_models": ["gpt-6.2-sol", "qwen3.7-plus"],
+    }  # fmt: skip
+    assert rig.review()["cost_usd"] == 0
+    assert rig.asked_used == [T0 - 500] and rig.asked_profiles == [["reviewer-fallback"]]
+    words = "reviewed on the fallback model qwen4-max, Claude at its usage limit since"
+    assert len(rig.events) == 1 and words in rig.events[0]
+    complete = next(c for c in rig.board.calls if c[0] == "complete")
+    assert words in complete[complete.index("--summary") + 1]
+    assert "schedule" not in rig.board.verbs() and rig.alerts == []
+
