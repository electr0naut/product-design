+def test_a_review_by_claude_says_nothing_and_one_by_the_second_model_names_it():
+    assert fallback.said({"cost_usd": 1}) == ""
+    who = {"fallback_model": MODEL, "claude_limited_since": T0, "authors_models": ["a", "b"]}
+    said = fallback.said({"reviewer": who})
+    assert "reviewed on the fallback model qwen4-max" in said and "authors ran on: a, b" in said
