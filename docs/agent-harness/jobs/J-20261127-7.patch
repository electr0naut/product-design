+def test_a_failed_call_is_a_fault_and_is_not_asked_again():
+    m = Model('{"a": 1}', '{"a": 1}', code=1)
+    with pytest.raises(FallbackFault, match=r"failed \(1\): stderr words"):
+        m.call()("q", SCHEMA)
