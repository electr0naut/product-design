+def test_the_pack_holds_every_text_file_and_names_what_it_left_out(tmp_path):
+    git(tmp_path, "init", "-q", "-b", "main")
+    (tmp_path / "a.py").write_text("A = 1\n")
+    (tmp_path / "vendor").mkdir()
+    (tmp_path / "vendor" / "big.js").write_text("x" * 50)
+    (tmp_path / "logo.bin").write_bytes(b"\x00\xff\x00")
+    git(tmp_path, "add", "-A")
+    git(tmp_path, "commit", "-q", "-m", "a")
+    pack = fallback.source_pack(repo_git(tmp_path), "HEAD", lambda n: n.startswith("vendor/"), 1000)
+    assert "--- File: a.py ---\nA = 1\n" in pack and "x" * 50 not in pack
+    assert "Left out (generated, vendored or not text): logo.bin, vendor/big.js." in pack
