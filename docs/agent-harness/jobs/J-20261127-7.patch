+class Model:
+    """A stand-in profile: replies in order; `seen` is what its sessions then show."""
+
+    def __init__(self, *replies, seen=SEEN, code=0):
+        self.replies, self.seen, self.code, self.asked = list(replies), seen, code, []
+
+    def ask(self, text):
+        self.asked.append(text)
+        reply = self.replies.pop(0)
+        if isinstance(reply, BaseException):
+            raise reply
+        return self.code, reply, "stderr words"
+
+    def call(self, s=S):
+        return fallback.make_call(
+            s, self.ask, lambda start: self.seen, reviewer.parse_json_objects, reviewer.validate
+        )
+
+
+def test_a_valid_reply_is_returned_and_the_schema_is_in_the_question():
+    m = Model('Sure:\n{"a": 1}')
+    assert m.call()("question", SCHEMA) == {"a": 1}
+    assert m.asked[0].startswith("question") and json.dumps(SCHEMA) in m.asked[0]
+
+
+def test_a_wrong_shape_is_asked_again_once_with_the_reason():
+    m = Model('{"a": "one"}', '{"a": 2}')
+    assert m.call()("q", SCHEMA) == {"a": 2}
+    assert "Your previous reply was rejected" in m.asked[1] and len(m.asked) == 2
+
+
+def test_two_wrong_replies_are_a_fault():
+    with pytest.raises(FallbackFault, match="invalid after one re-ask"):
+        Model("no json here", '{"b": 1}').call()("q", SCHEMA)
+
+
+@pytest.mark.parametrize(
+    ("seen", "word"),
+    [
+        ({"models": [MODEL], "tool_calls": 1, "sessions": 1}, "1 tool call"),
+        ({"models": ["qwen3.7-plus"], "tool_calls": 0, "sessions": 1}, "not on qwen4-max alone"),
+        ({"models": [MODEL, "x"], "tool_calls": 0, "sessions": 2}, "not on qwen4-max alone"),
+        ({"models": [""], "tool_calls": 0, "sessions": 1}, "not on qwen4-max alone"),
+    ],
+)
+def test_a_tool_call_or_another_model_discards_a_good_answer(seen, word):
+    with pytest.raises(FallbackFault, match=word):
+        Model('{"a": 1}', seen=seen).call()("q", SCHEMA)
+
