+"""The roles read the ticket from a file: Hermes cuts a parent card's result at 4 KB."""
+
+import pytest
+from test_d15 import World, w  # noqa: F401
+
+from harness import HarnessError, gatekeeper, loader, queue, specs
+from harness.loader import Ticket
+from harness.reviewer import RunFileError
+
+LONG = "\n".join(f"AC{n}: the criterion number {n} " + "x" * 80 for n in range(1, 90))
+RAW = f'+++\nkey = "FXL-1B"\ntitle = "a long ticket"\nrank = 1\n+++\n{LONG}\n'
+
+
+def ticket() -> Ticket:
+    return loader.parse_ticket_text(RAW, "test")
+
+
+def test_ticket_text_longer_than_the_cut_is_whole_in_the_file(tmp_path):
+    t = ticket()
+    assert len(t.body) > 4096
+    path = loader.write_ticket_file(t, tmp_path)
+    assert path == tmp_path / "work" / "runs" / "FXL-1B" / "ticket.md"
+    assert path.read_text() == f"# FXL-1B: a long ticket\n\n{t.body}\n"
+
+
+def test_write_ticket_file_symlinked_run_folder_refuses(tmp_path):
+    runs = tmp_path / "work" / "runs"
+    runs.mkdir(parents=True)
+    (tmp_path / "elsewhere").mkdir()
+    (runs / "FXL-1B").symlink_to(tmp_path / "elsewhere")
+    with pytest.raises(HarnessError, match="symlink"):
+        loader.write_ticket_file(ticket(), tmp_path)
+    assert not list((tmp_path / "elsewhere").iterdir())
+
+
+def test_write_ticket_file_symlinked_file_is_not_followed(tmp_path):
+    run = tmp_path / "work" / "runs" / "FXL-1B"
+    run.mkdir(parents=True)
+    target = tmp_path / "target"
+    target.write_text("kept")
+    (run / "ticket.md").symlink_to(target)
+    with pytest.raises(OSError):
+        loader.write_ticket_file(ticket(), tmp_path)
+    assert target.read_text() == "kept"
+
+
+@pytest.mark.parametrize("stage", ["triage", "planner", "implementer", "scribe"])
+def test_stage_body_names_the_ticket_file_and_not_the_parent_results_as_source(stage, tmp_path):
+    body = loader.stage_body(stage, ticket(), tmp_path / "r", tmp_path / "k")
+    assert f"The whole ticket is the file {tmp_path}/k/work/runs/FXL-1B/ticket.md" in body
+    assert "from its first line to its last" in body
+    assert "The ticket text is in the parent task results" not in body
+
+
+def test_fix_pass_body_names_the_ticket_file(tmp_path):
+    from harness import fixloop
+
+    run = tmp_path / "k" / "work" / "runs" / "FXL-1B"
+    body = fixloop.implementer_body("FXL-1B", 1, tmp_path / "r", run, tmp_path / "k")
+    assert f"The whole ticket is the file {run}/ticket.md" in body
+
+
+# ---- the gatekeeper runner refuses a changed ticket file ----
+
+
+def host(tmp_path):
+    root = tmp_path / "state" / "trusted"
+    specs.record_tickets([ticket()], root)
+    return root
+
+
+def test_check_ticket_file_same_text_passes(tmp_path):
+    root = host(tmp_path)
+    path = loader.write_ticket_file(ticket(), tmp_path)
+    gatekeeper.check_ticket_file(path.parent, "FXL-1B", root)
+
+
+def test_check_ticket_file_changed_text_refuses(tmp_path):
+    root = host(tmp_path)
+    path = loader.write_ticket_file(ticket(), tmp_path)
+    path.write_text(path.read_text().replace("AC7:", "AC7 (dropped):"))
+    with pytest.raises(RunFileError, match="not the ticket the host holds"):
+        gatekeeper.check_ticket_file(path.parent, "FXL-1B", root)
+
+
+def test_check_ticket_file_symlink_refuses(tmp_path):
+    root = host(tmp_path)
+    path = loader.write_ticket_file(ticket(), tmp_path)
+    copy = tmp_path / "copy.md"
+    copy.write_text(path.read_text())
+    path.unlink()
+    path.symlink_to(copy)
+    with pytest.raises(RunFileError):
+        gatekeeper.check_ticket_file(path.parent, "FXL-1B", root)
+
+
+def test_check_ticket_file_absent_passes_for_a_ticket_loaded_before(tmp_path):
+    gatekeeper.check_ticket_file(tmp_path, "FXL-1B", tmp_path / "state" / "trusted")
+
+
+# ---- the decision that corrects cards already on the board ----
+
+
+def prepared(w, statuses):
+    """FXL-1B with a host ticket, a run folder, and stage cards in the given statuses."""
+    specs.record_tickets([ticket()], w.root)
+    run = w.tmp / "kit" / "work" / "runs" / "FXL-1B"
+    run.mkdir(parents=True)
+    (run / "repo.txt").write_text(f"{w.tmp}/kit/work/fix-lens\n")
+    w.board.cards.clear()
+    for n, (stage, status) in enumerate(statuses.items()):
+        cid = f"t_eeee{n:04d}"
+        w.board.cards[cid] = {"id": cid, "title": f"FXL-1B · {stage}", "status": status}
+    return run
+
+
+def test_refresh_cards_writes_the_file_and_replaces_only_open_card_text(w):
+    run = prepared(w, {"triage": "blocked", "planner": "todo", "implementer": "done"})
+    w.decide("D-20261128-1", "refresh_cards")
+    (line,) = w.run()
+    assert line.startswith("applied D-20261128-1: ticket.md written for FXL-1B")
+    assert "card text replaced on: triage, planner" in line
+    assert (run / "ticket.md").read_text() == loader.ticket_text(ticket())
+    edits = [c for c in w.board.calls if c[0] == "edit"]
+    assert [c[1] for c in edits] == ["t_eeee0000", "t_eeee0001"]
+    assert all(c[2] == "--body" and f"{run}/ticket.md" in c[3] for c in edits)
+    assert "unblock" not in w.board.verbs()
+    assert w.run() == []
+
+
+def test_refresh_cards_running_card_rejects_and_changes_nothing(w):
+    run = prepared(w, {"triage": "done", "planner": "running"})
+    w.decide("D-20261128-1", "refresh_cards")
+    (line,) = w.run()
+    assert line.startswith("rejected D-20261128-1") and "is running" in line
+    assert not (run / "ticket.md").exists() and w.board.calls == []
+
+
+def test_refresh_cards_ticket_without_cards_rejects(w):
+    w.decide("D-20261128-1", "refresh_cards", key="FXL-77")
+    assert "has no stage card" in w.run()[0]
+
+
+def test_refresh_cards_links_the_triage_behind_the_ticket_before_it_again(w):
+    prepared(w, {"triage": "blocked"})
+    w.board.cards["t_gate0001"] = {"id": "t_gate0001", "title": "accept FXL-1A", "status": "todo"}
+    queue.write_queue([Ticket("FXL-1A", "a", 1), ticket()], w.root)
+    w.board.shown = {"t_eeee0000": {"parents": ["t_other"]}}
+    w.decide("D-20261128-1", "refresh_cards")
+    (line,) = w.run()
+    assert "; triage waits on 'accept FXL-1A' again" in line
+    assert ["link", "t_gate0001", "t_eeee0000"] in w.board.calls
+
+
+def test_refresh_cards_finished_predecessor_adds_no_link(w):
+    prepared(w, {"triage": "blocked"})
+    w.board.cards["t_gate0001"] = {"id": "t_gate0001", "title": "accept FXL-1A", "status": "done"}
+    queue.write_queue([Ticket("FXL-1A", "a", 1), ticket()], w.root)
+    w.decide("D-20261128-1", "refresh_cards")
+    assert "again" not in w.run()[0] and "link" not in w.board.verbs()
+
+
+def test_refresh_cards_already_linked_adds_no_second_link(w):
+    prepared(w, {"triage": "todo"})
+    w.board.cards["t_gate0001"] = {"id": "t_gate0001", "title": "accept FXL-1A", "status": "todo"}
+    queue.write_queue([Ticket("FXL-1A", "a", 1), ticket()], w.root)
+    w.board.shown = {"t_eeee0000": {"parents": ["t_gate0001"]}}
+    w.decide("D-20261128-1", "refresh_cards")
+    assert "again" not in w.run()[0] and "link" not in w.board.verbs()
