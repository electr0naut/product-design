+        cards = _cards(self.kanban)
+        mine = [c for c in cards if str(c.get("title", "")).startswith(f"{key} · ")]
+        if not mine:
+            raise HarnessError(f"{key} has no stage card on the board")
+        busy = [c["title"] for c in mine if c.get("status") == "running"]
+        if busy:
+            raise HarnessError(f"a card of {key} is running: {', '.join(busy)}")
+        ticket = loader.parse_ticket_text(specs.read_ticket(key, self.root), f"the host's {key}.md")
+        run = self.kit / "work" / "runs" / key
+        try:
+            repo = Path((run / "repo.txt").read_text().strip())
+        except OSError as exc:
+            raise HarnessError(f"{key} has no repo.txt in its run folder: {exc}") from exc
+        loader.write_ticket_file(ticket, self.kit)
+        edited = []
+        for stage in loader.STAGES:
+            card = _one(mine, f"{key} · {stage}")
+            if card is None or card.get("status") not in ("todo", "ready", "blocked"):
+                continue
+            body = loader.stage_body(stage, ticket, repo, self.kit)
+            self.kanban(["edit", card["id"], "--body", body])
+            edited.append(stage)
+        out = f"ticket.md written for {key}; card text replaced on: {', '.join(edited) or 'none'}"
+        triage = _one(mine, f"{key} · triage")
+        before = self._queue_predecessor(key, cards)
+        if triage and before and triage.get("status") in ("todo", "blocked"):
+            parents = json.loads(self.kanban(["show", triage["id"], "--json"])).get("parents", [])
+            if before["id"] not in parents:
+                self.kanban(["link", before["id"], triage["id"]])
+                out += f"; triage waits on '{before['title']}' again"
+        return out
+
+    def _queue_predecessor(self, key: str, cards: list[dict]) -> dict | None:
+        """The open card that ends the ticket before `key` in the queue, if there is one."""
+        path = queue.queue_path(self.root)
+        if not path.exists():
+            return None
+        order = [t["key"] for t in json.loads(path.read_text())]
+        if key not in order or order.index(key) == 0:
+            return None
+        prev = order[order.index(key) - 1]
+        card = _one(cards, gate_title(prev)) or _one(cards, f"{prev} · scribe")
