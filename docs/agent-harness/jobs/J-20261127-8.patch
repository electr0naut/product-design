+def write_ticket_file(t: Ticket, kit: Path = KIT) -> Path:
+    """Write the ticket where the roles read it. The run folder is writable from the container, so
+    neither it nor the file may be a symlink."""
+    run = kit / "work" / "runs" / t.key
+    run.mkdir(parents=True, exist_ok=True)
+    if run.is_symlink() or run.resolve() != (kit / "work" / "runs").resolve() / t.key:
+        raise HarnessError(f"the run folder of {t.key} is a symlink; refusing to write into it")
+    path = run / "ticket.md"
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
+    with os.fdopen(fd, "w") as fh:
+        fh.write(ticket_text(t))
+    return path
